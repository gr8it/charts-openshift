  3: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-config-standalone
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-config-standalone
        helm.sh/chart: cluster-config-standalone-1.2.2
      name: pull-secret
      namespace: openshift-config
    spec:
      data:
        - remoteRef:
            key: apc-platform/d/cluster-config
            property: pull-secret
          secretKey: pullsecret
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: vault-issuer
      target:
        creationPolicy: Owner
        name: pull-secret
        template:
          data:
            .dockerconfigjson: '{{ .pullsecret | toString }}'
          type: kubernetes.io/dockerconfigjson
  4: |
