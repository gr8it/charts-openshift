        - mirrors:
            - quay.apps.example.com/registry.redhat.io
          source: registry.redhat.io
        - mirrors:
            - quay.apps.example.com/registry.connect.redhat.com
          source: registry.connect.redhat.com
        - mirrors:
            - quay.apps.example.com/docker.io
          source: docker.io
        - mirrors:
            - quay.apps.example.com/quay.io
          source: quay.io
        - mirrors:
            - quay.apps.example.com/ghcr.io
          source: ghcr.io
