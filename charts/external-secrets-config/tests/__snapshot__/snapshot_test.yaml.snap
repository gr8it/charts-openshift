manifests should match snapshot:
  1: |
    apiVersion: kubernetes.vault.upbound.io/v1alpha1
    kind: AuthBackendRole
    metadata:
      name: dev01-external-secrets-operator
    spec:
      forProvider:
        backend: dev01
        boundServiceAccountNames:
          - external-secrets-operator
        boundServiceAccountNamespaces:
          - apc-external-secrets-operator
        roleName: external-secrets-operator
        tokenPolicies:
          - default
          - apc-platform-d-external-secrets-operator
        tokenTtl: 900
      providerConfigRef:
        name: vault-hub-provider-config
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-admission-controller: "true"
      name: kyverno:cleanup-admission:eso-vault
    rules:
      - apiGroups:
          - vault.vault.upbound.io
        resources:
          - policies
        verbs:
          - get
          - list
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-background-controller: "true"
      name: kyverno:background-controller:eso-vault
    rules:
      - apiGroups:
          - ""
        resources:
          - serviceaccounts
        verbs:
          - create
          - delete
          - update
      - apiGroups:
          - kubernetes.vault.upbound.io
        resources:
          - authbackendroles
        verbs:
          - create
          - get
      - apiGroups:
          - external-secrets.io
        resources:
          - secretstores
        verbs:
          - get
          - list
          - watch
          - create
          - delete
          - update
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - clusterrolebindings
        verbs:
          - get
          - create
          - list
          - watch
          - update
          - delete
      - apiGroups:
          - vault.vault.upbound.io
        resources:
          - policies
        verbs:
          - get
          - create
          - list
          - watch
          - update
          - patch
          - delete
      - apiGroups:
          - auth.vault.upbound.io
        resources:
          - backends
        verbs:
          - get
          - list
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-cleanup-controller: "true"
      name: kyverno:cleanup-controller:eso-vault
    rules:
      - apiGroups:
          - ""
        resources:
          - namespaces
        verbs:
          - list
          - get
      - apiGroups:
          - kubernetes.vault.upbound.io
        resources:
          - authbackendroles
        verbs:
          - delete
          - list
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: external-secrets-config
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: external-secrets-config
        helm.sh/chart: external-secrets-config-2.0.0
      name: external-secrets-config-auth-delegator
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: system:auth-delegator
    subjects:
      - kind: ServiceAccount
        name: external-secrets-operator
        namespace: apc-external-secrets-operator
  6: |
    apiVersion: external-secrets.io/v1beta1
    kind: ClusterSecretStore
    metadata:
      name: vault-example
    spec:
      conditions:
        - namespaceSelector:
            matchLabels:
              apc.namespace.type: platform
        - namespaceRegexes:
            - openshift-.*
      provider:
        vault:
          auth:
            kubernetes:
              mountPath: dev01
              role: external-secrets-operator
          caProvider:
            key: ca.crt
            name: external-secrets-config-ca-certificates
            namespace: apc-external-secrets-operator
            type: ConfigMap
          path: apc-platform
          server: https://vault.example.com
          version: v2
  7: |
    apiVersion: v1
    data:
      ca.crt: |
        -----BEGIN CERTIFICATE-----
        aaa
        -----END CERTIFICATE-----
        -----BEGIN CERTIFICATE-----
        bbb
        -----END CERTIFICATE-----
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: external-secrets-config
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: external-secrets-config
        helm.sh/chart: external-secrets-config-2.0.0
      name: external-secrets-config-ca-certificates
      namespace: apc-external-secrets-operator
  8: |
    apiVersion: policies.kyverno.io/v1
    kind: DeletingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Cleanup AuthBackendRoles
      name: app-project-eso-vault-cleanup
    spec:
      conditions:
        - expression: '!(variables.namespace in variables.appNamespaces)'
          name: namespace-not-an-application-namespace
      matchConstraints:
        objectSelector:
          matchExpressions:
            - key: generate.kyverno.io/policy-name
              operator: In
              values:
                - app-project-eso-vault
                - app-project-eso-vault-auth-backend-role
        resourceRules:
          - apiGroups:
              - kubernetes.vault.upbound.io
            apiVersions:
              - '*'
            resources:
              - authbackendroles
      schedule: 0 */4 * * *
      variables:
        - expression: object.metadata.name.split('-')
          name: nameParts
        - expression: variables.nameParts.slice(0, size(variables.nameParts) - 1).join('-')
          name: namespace
        - expression: 'dyn(resource.List("v1", "namespaces", "", {"apc.namespace.type": "application"}).items).map(n, n.metadata.name)'
          name: appNamespaces
  9: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Setup vault kubernetes auth role
      name: app-project-eso-vault-auth-backend-role
    spec:
      evaluation:
        generateExisting:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: kubernetes.vault.upbound.io/v1alpha1
              kind: AuthBackendRole
              metadata:
                name: (( object.metadata.name ))-vie
              spec:
                forProvider:
                  roleName: (( object.metadata.name ))-vie
                  boundServiceAccountNames:
                    - vault-auth
                  boundServiceAccountNamespaces:
                    - (( object.metadata.name ))
                  backend: dev01
                  tokenTtl: 900
                  tokenPolicies:
                    - apc-d-svc-vie
                providerConfigRef:
                  name: vault-hub-provider-config
      matchConditions:
        - expression: dyn(resource.Get("kubernetes.vault.upbound.io/v1alpha1", "authbackendroles", "", object.metadata.name + "-vie")) == null
          name: auth-backend-role-missing
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
  10: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Create vault-auth ServiceAccount
      name: app-project-eso-vault-sa
    spec:
      evaluation:
        generateExisting:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: v1
              kind: ServiceAccount
              metadata:
                name: vault-auth
                namespace: (( object.metadata.name ))
      matchConditions:
        - expression: dyn(resource.Get("v1", "serviceaccounts", object.metadata.name, "vault-auth")) == null
          name: serviceaccount-missing
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
  11: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Setup vault access and generate SecretStore
      name: app-project-eso-vault
    spec:
      evaluation:
        generateExisting:
          enabled: true
        skipBackgroundRequests: false
        synchronize:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: external-secrets.io/v1beta1
              kind: SecretStore
              metadata:
                name: vault-hub01
                namespace: (( object.metadata.name ))
              spec:
                retrySettings:
                  maxRetries: 5
                  retryInterval: 10s
                provider:
                  vault:
                    server: https://vault.example.com
                    path: apc
                    version: v2
                    caProvider:
                      type: ConfigMap
                      name: kube-root-ca.crt
                      key: ca.crt
                    auth:
                      kubernetes:
                        mountPath: dev01
                        role: (( object.metadata.name ))-vie
                        serviceAccountRef:
                          name: vault-auth
        - template:
            interpolate: cel
            value: |
              apiVersion: rbac.authorization.k8s.io/v1
              kind: ClusterRoleBinding
              metadata:
                name: (( object.metadata.name ))-auth-delegator
              roleRef:
                apiGroup: rbac.authorization.k8s.io
                kind: ClusterRole
                name: system:auth-delegator
              subjects:
                - kind: ServiceAccount
                  namespace: (( object.metadata.name ))
                  name: vault-auth
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
  12: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Setup vault access policy
      name: policy-svc-vie
    spec:
      evaluation:
        generateExisting:
          enabled: true
        synchronize:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: vault.vault.upbound.io/v1alpha1
              kind: Policy
              metadata:
                name: apc-d-svc-vie
              spec:
                deletionPolicy: Orphan
                forProvider:
                  name: apc-d-svc-vie

                  policy: |

                    path "apc/d/{{identity.entity.aliases.(( object.status.atProvider.accessor )).metadata.service_account_namespace}}/*" {
                      capabilities = ["read", "list"]
                    }
                    path "apc/data/d/{{identity.entity.aliases.(( object.status.atProvider.accessor )).metadata.service_account_namespace}}/*" {
                      capabilities = ["read", "list"]
                    }
                    path "apc/metadata/d/{{identity.entity.aliases.(( object.status.atProvider.accessor )).metadata.service_account_namespace}}/*" {
                      capabilities = ["read", "list"]
                    }
                providerConfigRef:
                  name: vault-hub-provider-config
      matchConditions:
        - expression: object.spec.?forProvider.?type.orValue('') == 'kubernetes'
          name: kubernetes-backend
        - expression: object.?status.?atProvider.?accessor.orValue('') != ''
          name: accessor-known
      matchConstraints:
        resourceRules:
          - apiGroups:
              - auth.vault.upbound.io
            apiVersions:
              - '*'
            operations:
              - CREATE
              - UPDATE
            resources:
              - backends
      useServerSideApply: true
  13: |
    apiVersion: vault.vault.upbound.io/v1alpha1
    kind: Policy
    metadata:
      name: apc-platform-d-external-secrets-operator
    spec:
      forProvider:
        name: apc-platform-d-external-secrets-operator
        policy: |
          path "apc-platform/d/*" {
            capabilities = ["create", "read", "update", "patch", "list"]
          }
          path "apc-platform/data/d/*" {
            capabilities = ["create", "read", "update", "patch", "list"]
          }
          path "apc-platform/metadata/d/*" {
            capabilities = ["create", "read", "update", "patch", "list"]
          }
      providerConfigRef:
        name: vault-hub-provider-config
