{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "required": ["envName", "osImageVersion"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "environmentShort": { "type": "string" },
    "proxy": { "type": "string" },
    "noProxy": { "type": "string" },
    "ntpServers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sshAuthorizedKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecretsOperator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultClusterSecretStore": { "type": "string" }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "KVmountPlatform": { "type": "string" }
          }
        }
      }
    },
    "envName": { "type": "string", "minLength": 1 },
    "agentEnvironment": { "type": "string" },
    "infraEnvName": { "type": "string" },
    "location": { "type": "string" },
    "cpuArchitecture": {
      "type": "string",
      "enum": ["x86_64", "aarch64", "ppc64le", "s390x"]
    },
    "ipxeScriptType": { "type": "string" },
    "osImageVersion": { "type": "string", "minLength": 1 },
    "nmStateConfigs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "interfaces", "config"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["macAddress", "name"],
              "additionalProperties": false,
              "properties": {
                "macAddress": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "config": { "type": "object" }
        }
      }
    },
    "apc-global-overrides": { "type": "object" },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "paused": { "type": "boolean" },
        "ttl": { "type": "string", "minLength": 1 }
      }
    }
  }
}
