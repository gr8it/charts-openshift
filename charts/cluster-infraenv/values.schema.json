{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "required": ["envName"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "envName": { "type": "string", "minLength": 1 },
    "agentEnvironment": { "type": "string" },
    "infraEnvName": { "type": "string" },
    "location": { "type": "string" },
    "cpuArchitecture": { "type": "string", "enum": ["x86_64", "aarch64", "ppc64le", "s390x"] },
    "ipxeScriptType": { "type": "string" },
    "nmStateConfigs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "interfaces", "config"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["macAddress", "name"],
              "additionalProperties": false,
              "properties": {
                "macAddress": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "config": { "type": "object" }
        }
      }
    },
    "apc-global-overrides": { "type": "object" }
  }
}
