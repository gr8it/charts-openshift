{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "envName": { "type": "string" },
    "infraEnvName": { "type": "string" },
    "location": { "type": "string" },
    "cpuArchitecture": { "type": "string", "enum": ["x86_64", "aarch64", "ppc64le", "s390x"] },
    "ipxeScriptType": { "type": "string" },
    "sshAuthorizedKey": { "type": "string" },
    "ntpServers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nmStateConfigs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "macInterfaceMappings", "networkConfig"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "macInterfaceMappings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["macAddress", "logicalNICName"],
              "additionalProperties": false,
              "properties": {
                "macAddress": { "type": "string" },
                "logicalNICName": { "type": "string" }
              }
            }
          },
          "networkConfig": { "type": "object" }
        }
      }
    },
    "apc-global-overrides": { "type": "object" }
  }
}
