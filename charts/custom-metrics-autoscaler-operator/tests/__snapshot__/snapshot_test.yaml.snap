manifests should match snapshot:
  1: |
    apiVersion: policy.open-cluster-management.io/v1beta1
    kind: OperatorPolicy
    metadata:
      annotations: {}
      labels:
        app.kubernetes.io/instance: custom-metrics-autoscaler-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: acm-operatorpolicy
        app.kubernetes.io/version: v1beta1
        helm.sh/chart: acm-operatorpolicy-1.3.0
      name: custom-metrics-autoscaler-operator-acm-operatorpolicy
      namespace: open-cluster-management-policies
    spec:
      complianceConfig:
        catalogSourceUnhealthy: Compliant
        deploymentsUnavailable: NonCompliant
        upgradesAvailable: Compliant
      complianceType: musthave
      operatorGroup:
        name: openshift-keda
        namespace: openshift-keda
        targetNamespaces:
          - openshift-keda
      remediationAction: enforce
      removalBehavior:
        clusterServiceVersions: Delete
        customResourceDefinitions: Keep
        operatorGroups: DeleteIfUnused
        subscriptions: Delete
      severity: medium
      subscription:
        channel: stable
        name: custom-metrics-autoscaler-operator
        namespace: openshift-keda
        source: redhat-operators
        sourceNamespace: openshift-marketplace
        startingCSV: custom-metrics-autoscaler-operator.v2.19.0-3
      upgradeApproval: Automatic
      versions:
        - custom-metrics-autoscaler-operator.v2.19.0-3
  2: |
    raw: |
      Custom Metrics Autoscaler Operator 2.19.0-3 is managed by the generated ACM OperatorPolicy.
  3: |
    apiVersion: policy.open-cluster-management.io/v1
    kind: ConfigurationPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: custom-metrics-autoscaler-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: custom-metrics-autoscaler-operator
        app.kubernetes.io/version: 2.19.0-3
        helm.sh/chart: custom-metrics-autoscaler-operator-1.0.0
      name: custom-metrics-autoscaler-operator-namespace-monitoring
      namespace: open-cluster-management-policies
    spec:
      object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: v1
            kind: Namespace
            metadata:
              labels:
                openshift.io/cluster-monitoring: "true"
              name: openshift-keda
      pruneObjectBehavior: None
      remediationAction: enforce
      severity: medium
