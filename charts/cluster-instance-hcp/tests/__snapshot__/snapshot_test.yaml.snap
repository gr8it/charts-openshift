        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: machineconfig-mirror-registries
      namespace: example01
  7: |
    apiVersion: v1
    data:
      my-registry.example.com..443: |
        -----BEGIN CERTIFICATE-----
        MIIBxTCCAW+gAwIBAgIJAExample
        -----END CERTIFICATE-----
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
