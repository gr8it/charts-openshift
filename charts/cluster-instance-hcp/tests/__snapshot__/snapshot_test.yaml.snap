  30: |
    apiVersion: velero.io/v1
    kind: Schedule
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: example01
      namespace: openshift-adp
    spec:
      paused: false
      schedule: 0 0 * * *
      template:
        excludedNamespaceScopedResources:
          - events
          - events.events.k8s.io
          - pods
          - replicasets.apps
        includedNamespaceScopedResources:
          - '*'
        includedNamespaces:
          - example01
          - example01-example01
          - klusterlet-example01
        resourcePolicy:
          kind: configmap
          name: velero-resource-policy-example01
        snapshotMoveData: false
        ttl: 336h0m0s
