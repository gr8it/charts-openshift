  23: |
    apiVersion: cluster.open-cluster-management.io/v1
    kind: ManagedCluster
    metadata:
      annotations:
        argocd.argoproj.io/sync-wave: "0"
        import.open-cluster-management.io/hosting-cluster-name: local-cluster
        import.open-cluster-management.io/klusterlet-deploy-mode: Hosted
        open-cluster-management/created-via: hypershift
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        cloud: BareMetal
        cluster.open-cluster-management.io/clusterset: default
        helm.sh/chart: cluster-instance-hcp-2.0.23
        name: example01
        vendor: OpenShift
      name: example01
    spec:
      hubAcceptsClient: true
  24: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        argocd.argoproj.io/hook: Sync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
        argocd.argoproj.io/sync-wave: "5"
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: nodepool-release-check-example01
      namespace: example01
    spec:
      backoffLimit: 0
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: cluster-instance-hcp
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: cluster-instance-hcp
            helm.sh/chart: cluster-instance-hcp-2.0.23
        spec:
          containers:
            - args:
                - |
                  set -euo pipefail

                  log() {
                    printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"
                  }

                  while true; do
                    nodepool=$(oc get nodepool "nodepool-${HOSTED_CLUSTER}-1" \
                      -n "$NAMESPACE" \
                      --ignore-not-found \
                      -o name)

                    if [[ -z "$nodepool" ]]; then
                      log "NodePool nodepool-${HOSTED_CLUSTER}-1 does not exist; allowing initial installation"
                      exit 0
                    fi

                    status=$(oc get hostedcluster "$HOSTED_CLUSTER" \
                      -n "$NAMESPACE" \
                      --ignore-not-found \
                      -o jsonpath='{.metadata.generation}{"|"}{.spec.release.image}{"|"}{.status.version.desired.version}{"|"}{.status.version.desired.image}{"|"}{.status.version.history[0].state}{"|"}{.status.version.history[0].version}{"|"}{.status.version.history[0].image}{"|"}{.status.conditions[?(@.type=="Available")].status}{"|"}{.status.conditions[?(@.type=="Available")].observedGeneration}')

                    if [[ -z "$status" ]]; then
                      log "HostedCluster $HOSTED_CLUSTER does not exist; allowing initial installation"
                      exit 0
                    fi

                    IFS='|' read -r generation spec_image desired_version desired_image history_state history_version history_image available_status available_generation <<< "$status"
                    if [[ "$spec_image" =~ :([0-9]+\.[0-9]+\.[0-9]+) ]]; then
                      spec_version="${BASH_REMATCH[1]}"
                    else
                      spec_version=""
                    fi

                    log "HostedCluster release: spec=$spec_version desired=$desired_version latest=$history_version ($history_state) available=$available_status generation=$available_generation/$generation; waiting for $EXPECTED_VERSION"
                    if [[ "$spec_version" == "$EXPECTED_VERSION" \
                      && "$desired_version" == "$EXPECTED_VERSION" \
                      && "$history_state" == "Completed" \
                      && "$history_version" == "$EXPECTED_VERSION" \
                      && "$history_image" == "$desired_image" \
                      && "$available_status" == "True" \
                      && "$available_generation" == "$generation" ]]; then
                      log "HostedCluster release $EXPECTED_VERSION is completed and available"
                      exit 0
                    fi

                    sleep 30
                  done
              command:
                - /bin/bash
                - -c
              env:
                - name: HOSTED_CLUSTER
                  value: example01
                - name: NAMESPACE
                  value: example01
                - name: EXPECTED_VERSION
                  value: 4.17.11
              image: registry.redhat.io/openshift4/ose-cli:v4.15
              imagePullPolicy: IfNotPresent
              name: verify-hostedcluster-release
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          restartPolicy: Never
          serviceAccountName: nodepool-release-check-example01
          volumes:
            - emptyDir: {}
              name: tmp
  25: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      annotations:
        argocd.argoproj.io/hook: PreSync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
        argocd.argoproj.io/sync-wave: "0"
      labels:
