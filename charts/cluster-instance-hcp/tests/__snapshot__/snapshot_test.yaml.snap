  9: |
    apiVersion: v1
    data:
      policies.yaml: |
        version: v1
        policies:
          - name: exclude-specific-secrets
            action: skip
            target:
              - groupResource: secrets
                names:
                  - bootstrap-hub-kubeconfig
                  - hub-kubeconfig-secret
                  - "example01-import"
                namespaces:
                  - "klusterlet-example01"
                  - "example01-example01"
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: velero-resource-policy-example01
      namespace: openshift-adp
  10: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: etcd-hcp-backup-example01
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: etcd-hcp-backup
        app.kubernetes.io/version: 2.0.23
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-backup-example01
      namespace: example01-example01
    spec:
      concurrencyPolicy: Forbid
      failedJobsHistoryLimit: 7
      jobTemplate:
        metadata:
          labels:
            app.kubernetes.io/component: etcd-backup
            app.kubernetes.io/instance: etcd-hcp-backup-example01
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: etcd-hcp-backup
            app.kubernetes.io/version: 2.0.23
            helm.sh/chart: cluster-instance-hcp-2.0.23
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/component: etcd-backup
                app.kubernetes.io/instance: etcd-hcp-backup-example01
                app.kubernetes.io/managed-by: Helm
                app.kubernetes.io/name: etcd-hcp-backup
                app.kubernetes.io/version: 2.0.23
                helm.sh/chart: cluster-instance-hcp-2.0.23
            spec:
              containers:
                - command:
                    - /bin/bash
                    - /usr/local/bin/s3upload.sh
                  env:
                    - name: RETENTION
                      valueFrom:
                        configMapKeyRef:
                          key: env.retention
                          name: etcd-hcp-backup-example01-scripts
                    - name: FILEPREFIX
                      valueFrom:
                        configMapKeyRef:
                          key: env.fileprefix
                          name: etcd-hcp-backup-example01-scripts
                    - name: AWS_CA_BUNDLE
                      value: /etc/ssl/certs/s3ca.crt
                  envFrom:
                    - secretRef:
                        name: etcd-hcp-example01-backup
                    - configMapRef:
                        name: etcd-hcp-example01-backup
                  image: docker.io/amazon/aws-cli:2.35.8
                  name: s3backup
                  resources:
                    limits:
                      cpu: 500m
                      memory: 512Mi
                    requests:
                      cpu: 500m
                      memory: 512Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                  volumeMounts:
                    - mountPath: /backup
                      name: workdir
                    - mountPath: /usr/local/bin/s3upload.sh
                      name: scripts
                      readOnly: true
                      subPath: s3upload.sh
                    - mountPath: /etc/ssl/certs/s3ca.crt
                      name: s3ca
                      readOnly: true
                      subPath: service-ca.crt
                    - mountPath: /tmp
                      name: tmp
              initContainers:
                - command:
                    - /bin/bash
                    - /usr/local/bin/init.sh
                  env:
                    - name: HOME
                      value: /tmp
                    - name: STATEFULSET
                      valueFrom:
                        configMapKeyRef:
                          key: env.etcdsts
                          name: etcd-hcp-backup-example01-scripts
                    - name: HCPNS
                      valueFrom:
                        configMapKeyRef:
                          key: env.hcpns
                          name: etcd-hcp-backup-example01-scripts
                  image: registry.redhat.io/openshift4/ose-cli:v4.15
                  name: init
                  resources:
                    limits:
                      cpu: 100m
                      memory: 512Mi
                    requests:
                      cpu: 100m
                      memory: 512Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                  volumeMounts:
                    - mountPath: /backup
                      name: workdir
                    - mountPath: /usr/local/bin/init.sh
                      name: scripts
                      readOnly: true
                      subPath: init.sh
                    - mountPath: /tmp
                      name: tmp
                - command:
                    - /bin/bash
                    - /usr/local/bin/etcdsnap.sh
                  env:
                    - name: HCPNS
                      valueFrom:
                        configMapKeyRef:
                          key: env.hcpns
                          name: etcd-hcp-backup-example01-scripts
                    - name: FILEPREFIX
                      valueFrom:
                        configMapKeyRef:
                          key: env.fileprefix
                          name: etcd-hcp-backup-example01-scripts
                    - name: COMPRESS
                      valueFrom:
                        configMapKeyRef:
                          key: env.compress
                          name: etcd-hcp-backup-example01-scripts
                  image: registry.redhat.io/openshift4/ose-etcd:v4.12
                  name: snapshot
                  resources:
                    limits:
                      cpu: 300m
                      memory: 512Mi
                    requests:
                      cpu: 300m
                      memory: 512Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                  volumeMounts:
                    - mountPath: /backup
                      name: workdir
                    - mountPath: /usr/local/bin/etcdsnap.sh
                      name: scripts
                      readOnly: true
                      subPath: etcdsnap.sh
              restartPolicy: Never
              securityContext:
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              serviceAccountName: etcd-hcp-backup-example01
              volumes:
                - emptyDir:
                    sizeLimit: 10Gi
                  name: workdir
                - configMap:
                    defaultMode: 365
                    name: etcd-hcp-backup-example01-scripts
                  name: scripts
                - configMap:
                    name: openshift-service-ca.crt
                  name: s3ca
                - emptyDir: {}
                  name: tmp
      schedule: 10 * * * *
      successfulJobsHistoryLimit: 7
      suspend: false
  11: |
    apiVersion: objectbucket.io/v1alpha1
    kind: ObjectBucketClaim
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Prune=false
        helm.sh/resource-policy: keep
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: etcd-hcp-backup-example01
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: etcd-hcp-backup
        app.kubernetes.io/version: 2.0.23
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-example01-backup
      namespace: example01-example01
    spec:
      bucketName: etcd-hcp-example01-backup
      storageClassName: ocs-storagecluster-ceph-rgw
  12: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-backup-example01-rules
      namespace: example01-example01
    spec:
      groups:
        - name: cronjob.rules
          rules:
            - alert: HostedClusterEtcdBackupJobFailure
              annotations:
                description: ETCD backup job for example01 {{ $labels.namespace }}/{{ $labels.job_name}} has failed.
                summary: ETCD backup job for example01 has failed
              expr: kube_job_failed{namespace="example01-example01", job_name=~"etcd-hcp-backup-example01-.*", condition="true"} > 0
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: HostedClusterEtcdBackupMissing
              annotations:
                description: No successful ETCD backup for example01 ({{ $labels.namespace }}/{{ $labels.cronjob }}) in the last 36 hours.
                summary: ETCD backup for example01 is missing
              expr: (time() - kube_cronjob_status_last_successful_time{namespace="example01-example01", cronjob="etcd-hcp-backup-example01"}) > 129600 or ((time() - kube_cronjob_created{namespace="example01-example01", cronjob="etcd-hcp-backup-example01"}) > 129600) and on (namespace, cronjob) absent(kube_cronjob_status_last_successful_time{namespace="example01-example01", cronjob="etcd-hcp-backup-example01"})
              labels:
                severity: critical
                team: platform
                vendor: aspecta
  13: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: etcd-hcp-backup-example01
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: etcd-hcp-backup
        app.kubernetes.io/version: 2.0.23
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-backup-example01
      namespace: example01-example01
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - list
      - apiGroups:
          - ""
        resourceNames:
          - etcd-0
          - etcd-1
          - etcd-2
          - etcd-3
          - etcd-4
        resources:
          - pods
        verbs:
          - get
      - apiGroups:
          - ""
        resourceNames:
          - etcd-0
          - etcd-1
          - etcd-2
          - etcd-3
          - etcd-4
        resources:
          - pods/exec
        verbs:
          - create
      - apiGroups:
          - apps
        resourceNames:
          - etcd
        resources:
          - statefulsets
        verbs:
          - get
  14: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: etcd-hcp-backup-example01
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: etcd-hcp-backup
        app.kubernetes.io/version: 2.0.23
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-backup-example01
      namespace: example01-example01
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: etcd-hcp-backup-example01
    subjects:
      - kind: ServiceAccount
        name: etcd-hcp-backup-example01
        namespace: example01-example01
  15: |
    apiVersion: v1
    data:
      env.compress: "false"
      env.etcdsts: etcd
      env.fileprefix: etcd-example01
      env.hcpns: example01-example01
      env.retention: "3"
      etcdsnap.sh: |
        #!/bin/bash
        set -euo pipefail

        log_message() {
          local timestamp
          timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
          echo -e "$timestamp $1"
        }

        log_messagef() {
          while read -r line; do
            log_message "$line"
          done < $1
        }

        export ETCDCTL_API=3

        if ! ENDPOINT=$(etcdctl --cacert=/backup/certs/ca.crt --cert=/backup/certs/etcd-client.crt --key=/backup/certs/etcd-client.key --endpoints=https://etcd-client."$HCPNS".svc:2379 member list 2>/dev/shm/out.err | awk -F', ' '$2 == "started" {print $5}' | shuf -n 1); then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get a list of etcd endpoints"
          exit 1
        fi

        if [ -z "${ENDPOINT+x}" ]; then
          log_message "ERROR: Failed to select a running etcd endpoint"
          exit 1
        fi

        if ! etcdctl --cacert=/backup/certs/ca.crt --cert=/backup/certs/etcd-client.crt --key=/backup/certs/etcd-client.key --endpoints="$ENDPOINT" endpoint health 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Endpoint $ENDPOINT is not healthy"
          exit 1
        fi

        DATESTRING=$(date -u "+%F_%H%M%SZ")
        SNAPSHOT_FILE="/backup/${FILEPREFIX}_${DATESTRING}.db"
        if ! etcdctl --cacert=/backup/certs/ca.crt --cert=/backup/certs/etcd-client.crt --key=/backup/certs/etcd-client.key --endpoints="$ENDPOINT" snapshot save "$SNAPSHOT_FILE" 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to create snapshot"
          exit 2
        fi

        if ! etcdutl snapshot status "$SNAPSHOT_FILE" 2>/dev/shm/out.err 1>/dev/null; then
          rm -f "$SNAPSHOT_FILE"
          log_messagef /dev/shm/out.err
          log_message "ERROR: Snapshot file integrity verification failed"
          exit 2
        fi

        if (echo 'yes true enable enabled 1' | grep -wqi "$COMPRESS"); then
          if ! gzip --best "$SNAPSHOT_FILE" 2>/dev/shm/out.err 1>/dev/null; then
            log_messagef /dev/shm/out.err
            log_message "ERROR: Failed to compress the snapshot file"
            exit 3
          fi

          if ! gzip --test "${SNAPSHOT_FILE}.gz" 2>/dev/shm/out.err 1>/dev/null; then
            log_messagef /dev/shm/out.err
            log_message "ERROR: Failed to test the archive integrity"
            exit 3
          fi

          log_message "Snapshot saved to ${SNAPSHOT_FILE}.gz"
        else
          log_message "Snapshot saved to ${SNAPSHOT_FILE}"
        fi

        exit 0
      init.sh: |
        #!/bin/bash
        set -euo pipefail

        log_message() {
          local timestamp
          timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
          echo -e "$timestamp $1"
        }

        log_messagef() {
          while read -r line; do
            log_message "$line"
          done < $1
        }

        find /backup -path '*/backup/*' -delete

        if ! READY=$(kubectl get statefulset "$STATEFULSET" -n "$HCPNS" -o jsonpath='{.status.readyReplicas}' 2>/dev/shm/out.err); then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get readyReplicas for StatefulSet/$STATEFULSET"
          exit 1
        fi

        if ! TOTAL=$(kubectl get statefulset "$STATEFULSET" -n "$HCPNS" -o jsonpath='{.status.replicas}' 2>/dev/shm/out.err); then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get replicas for StatefulSet/$STATEFULSET"
          exit 1
        fi

        if test "$READY" -ne "$TOTAL" || test "$(expr "$READY" + "$TOTAL")" -eq 0; then
          log_message "ERROR: Insufficient readyReplicas in StatefulSet/$STATEFULSET"
          exit 1
        fi

        if ! ETCDPOD=$(kubectl -n "$HCPNS" get po -l app=etcd -o custom-columns=":metadata.name,:status.conditions[?(@.type=='Ready')].status" 2>/dev/shm/out.err | awk '$2 == "True" {print $1}' | shuf -n 1); then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get a list of running etcd pods"
          exit 1
        fi

        if [ -z "${ETCDPOD+x}" ]; then
          log_message "ERROR: Failed to find a running etcd pod"
          exit 1
        fi

        mkdir /backup/certs

        if ! kubectl -n "$HCPNS" -c etcd cp "$ETCDPOD":/etc/etcd/tls/etcd-ca/..data/ca.crt /backup/certs/ca.crt 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get ca.crt from $ETCDPOD"
          exit 1
        fi

        if ! kubectl -n "$HCPNS" -c etcd cp "$ETCDPOD":/etc/etcd/tls/client/..data/etcd-client.crt /backup/certs/etcd-client.crt 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get etcd-client.crt from $ETCDPOD"
          exit 1
        fi

        if ! kubectl -n "$HCPNS" -c etcd cp "$ETCDPOD":/etc/etcd/tls/client/..data/etcd-client.key /backup/certs/etcd-client.key 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to get etcd-client.key from $ETCDPOD"
          exit 1
        fi

        log_message "Init complete."
        exit 0
      s3upload.sh: |
        #!/bin/bash
        set -euo pipefail

        log_message() {
          local timestamp
          timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
          echo -e "$timestamp $1"
        }

        log_messagef() {
          while read -r line; do
            log_message "$line"
          done < $1
        }

        SNAPSHOT_FILE=$(find /backup -type f -mmin -30 -name "${FILEPREFIX}*db*" | sort | tail -1)
        if ! test -r "$SNAPSHOT_FILE"; then
          log_message "ERROR: Failed to locate a valid snapshot file."
          exit 1
        fi

        export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
        export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
        export AWS_ENDPOINT_URL="https://${BUCKET_HOST}:${BUCKET_PORT}"

        if ! aws s3 cp "$SNAPSHOT_FILE" "s3://$BUCKET_NAME" --no-progress 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to upload $(basename "$SNAPSHOT_FILE") to s3://$BUCKET_NAME "
          exit 2
        fi

        if ! aws s3api head-object --bucket "$BUCKET_NAME" --key "$(basename "$SNAPSHOT_FILE")" 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Unable to verify uploaded object s3://${BUCKET_NAME}/$(basename "$SNAPSHOT_FILE")"
          exit 2
        fi

        log_message "Snapshot has been uploaded to s3://${BUCKET_NAME}/$(basename "$SNAPSHOT_FILE")"

        if ! expr "$RETENTION" : '^[0-9]\+$' 2>/dev/shm/out.err 1>/dev/null; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Value for retention is not a valid integer"
          exit 1
        fi

        if ! RETENTION_DATE=$(date -u --date="${RETENTION} days ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/shm/out.err); then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to set a retention date"
          exit 1
        fi

        if ! aws s3api list-objects-v2 --bucket "$BUCKET_NAME" --query "Contents[?LastModified<='$RETENTION_DATE'].{Key: Key} | {Objects: [*]}" 2>/dev/shm/out.err 1>/backup/delete.json; then
          log_messagef /dev/shm/out.err
          log_message "ERROR: Failed to generate a list of objects to delete"
          exit 1
        fi

        if grep -qE '"Objects":\s*\[\s*\]' /backup/delete.json; then
          log_message "No objects older than $RETENTION days found - skipping cleanup."
          exit 0
        fi

        log_message "Removing objects older than $RETENTION days:"
        if ! aws s3api delete-objects --bucket "$BUCKET_NAME" --delete file:///backup/delete.json --output text >/dev/shm/out 2>&1; then
          log_messagef /dev/shm/out
          log_message "ERROR: Failed to remove objects."
          exit 1
        fi

        log_messagef /dev/shm/out
        log_message "Cleanup complete."
        exit 0
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: etcd-backup
        app.kubernetes.io/instance: etcd-hcp-backup-example01
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: etcd-hcp-backup
        app.kubernetes.io/version: 2.0.23
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: etcd-hcp-backup-example01-scripts
