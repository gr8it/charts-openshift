          secretKey: tls.crt
        - remoteRef:
            key: apc-platform/p/example01-apiserver-cert
            property: tls.key
          secretKey: tls.key
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: vault
      target:
        creationPolicy: Owner
        name: kube-apiserver-cert
        template:
          type: kubernetes.io/tls
  12: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: pullsecret-cluster-example01
      namespace: example01
    spec:
      data:
        - remoteRef:
            key: apc-platform/p/example01-cluster
            property: .dockerconfigjson
          secretKey: pullsecret
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: vault
      target:
        creationPolicy: Owner
        name: pullsecret-cluster-example01
        template:
          data:
            .dockerconfigjson: '{{ .pullsecret | toString }}'
          type: kubernetes.io/dockerconfigjson
  13: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: sshkey-cluster-example01
      namespace: example01
    spec:
      data:
        - remoteRef:
            key: apc-platform/p/example01-cluster
            property: id_rsa.pub
          secretKey: id_rsa.pub
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: vault
      target:
        creationPolicy: Owner
        name: sshkey-cluster-example01
  14: |
    apiVersion: hypershift.openshift.io/v1beta1
    kind: HostedCluster
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        cluster.open-cluster-management.io/clusterset: prod
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: example01
      namespace: example01
    spec:
      additionalTrustBundle:
        name: user-ca-bundle
      configuration:
        apiServer:
          audit:
            profile: Default
          servingCerts:
            namedCertificates:
              - names:
                  - api.example01.cloud.example.com
                  - oauth.example01.cloud.example.com
                servingCertificate:
                  name: kube-apiserver-cert
        image:
          additionalTrustedCA:
            name: registry-ca-bundle
          imageContentSources:
            - mirrors:
                - my-registry.example.com/quay.io
              source: quay.io
            - mirrors:
                - my-registry.example.com/registry.connect.redhat.com
              source: registry.connect.redhat.com
            - mirrors:
                - my-registry.example.com/registry.redhat.io
              source: registry.redhat.io
            - mirrors:
                - my-registry.example.com/docker.io
              source: docker.io
            - mirrors:
                - my-registry.example.com/ghcr.io
              source: ghcr.io
        oauth:
          identityProviders:
            - ldap:
                attributes:
                  email:
                    - mail
                  id:
                    - sAMAccountName
                  name:
                    - cn
                  preferredUsername:
                    - sAMAccountName
                bindDN: CN=svc-ocp,OU=Service Accounts,DC=example,DC=com
                bindPassword:
                  name: ad-ldap-bind-secret
                ca:
                  name: ad-ldap-ca
                insecure: false
                url: ldaps://ad.example.com/DC=example,DC=com?sAMAccountName?sub?(objectClass=person)
              mappingMethod: claim
              name: AD Login
              type: LDAP
            - ldap:
                attributes:
                  email:
                    - mail
                  id:
                    - dn
                  name:
                    - cn
                  preferredUsername:
                    - uid
                bindDN: cn=svc-ocp,ou=Technical-Accounts,ou=prod,ou=Users,dc=example,dc=com
                bindPassword:
                  name: bastion-ldap-bind-secret
                ca:
                  name: bastion-ldap-ca
                insecure: false
                url: ldaps://ldap.example.com/OU=Users,dc=example,dc=com?uid
              mappingMethod: claim
              name: LDAP Login
              type: LDAP
        proxy:
          httpProxy: http://proxy.example.com:8080
          httpsProxy: http://proxy.example.com:8080
          noProxy: .example.com,.svc,.cluster.local
          trustedCA:
            name: user-ca-bundle
      controllerAvailabilityPolicy: HighlyAvailable
      dns:
        baseDomain: cloud.example.com
      etcd:
        managed:
          storage:
            persistentVolume:
              size: 8Gi
              storageClassName: lvms-vglvms
            type: PersistentVolume
        managementType: Managed
      infraID: example01
      infrastructureAvailabilityPolicy: HighlyAvailable
      networking:
        clusterNetwork:
          - cidr: 172.26.0.0/16
            hostPrefix: 21
        networkType: OVNKubernetes
        serviceNetwork:
          - cidr: 172.25.64.0/18
      nodeSelector:
        node-role.kubernetes.io/master: ""
      olmCatalogPlacement: management
      platform:
        agent:
          agentNamespace: infrastructure-example01
        type: Agent
      pullSecret:
        name: pullsecret-cluster-example01
      release:
        image: quay.io/openshift-release-dev/ocp-release:4.17.11-multi
      services:
        - service: APIServer
          servicePublishingStrategy:
            type: LoadBalancer
        - service: OAuthServer
          servicePublishingStrategy:
            nodePort:
              address: oauth.example01.cloud.example.com
              port: 30102
            type: NodePort
        - service: Konnectivity
          servicePublishingStrategy:
            nodePort:
              address: konnectivity.example01.cloud.example.com
              port: 30103
            type: NodePort
        - service: Ignition
          servicePublishingStrategy:
            nodePort:
              address: ignition.example01.cloud.example.com
              port: 30104
            type: NodePort
        - service: OIDC
          servicePublishingStrategy:
            nodePort:
              address: oidc.example01.cloud.example.com
              port: 30101
            type: NodePort
      sshKey:
        name: sshkey-cluster-example01
      tolerations:
        - effect: NoSchedule
          key: node-role.kubernetes.io/master
          operator: Exists
  15: |
    apiVersion: agent.open-cluster-management.io/v1
    kind: KlusterletAddonConfig
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: example01
      namespace: example01
    spec:
      applicationManager:
        enabled: true
      certPolicyController:
        enabled: true
      clusterLabels:
        cloud: BareMetal
        vendor: OpenShift
      clusterName: example01
      clusterNamespace: example01
      policyController:
        enabled: true
      searchCollector:
        enabled: true
  16: |
    apiVersion: cluster.open-cluster-management.io/v1
    kind: ManagedCluster
    metadata:
      annotations:
        import.open-cluster-management.io/hosting-cluster-name: local-cluster
        import.open-cluster-management.io/klusterlet-deploy-mode: Hosted
        open-cluster-management/created-via: hypershift
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        cloud: BareMetal
        cluster.open-cluster-management.io/clusterset: prod
        helm.sh/chart: cluster-instance-hcp-1.1.0
        name: example01
        vendor: OpenShift
      name: example01
    spec:
      hubAcceptsClient: true
  17: |
    apiVersion: v1
    kind: Namespace
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: example01
  18: |
    apiVersion: hypershift.openshift.io/v1beta1
    kind: NodePool
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: nodepool-example01-1
      namespace: example01
    spec:
      clusterName: example01
      config:
        - name: machineconfig-chrony
        - name: machineconfig-logind
        - name: kubeletconfig-worker
        - name: machineconfig-mirror-registries
      management:
        autoRepair: false
        upgradeType: InPlace
      nodeLabels:
        k8s.ovn.org/egress-assignable: ""
      platform:
        agent:
          agentLabelSelector:
            matchLabels: {}
        type: Agent
      release:
        image: quay.io/openshift-release-dev/ocp-release:4.17.11-multi
      replicas: 4
