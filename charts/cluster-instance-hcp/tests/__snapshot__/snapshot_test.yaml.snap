  3: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: KubeletConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: logrotation
        spec:
          kubeletConfig:
            containerLogMaxFiles: 5
            containerLogMaxSize: 20Mi
            podsPerCore: 0
            maxPods: 350
            systemReserved:
              cpu: 800m
              memory: 4Gi
              ephemeral-storage: 3Gi
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: kubeletconfig-worker
      namespace: example01
  4: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: 99-worker-chrony
        spec:
          config:
            ignition:
              version: 3.4.0
            storage:
              files:
                - contents:
                    compression: ''
                    source: 'data:text/plain;charset=utf-8;base64,c2VydmVyIG50cC5leGFtcGxlLmNvbSBpYnVyc3QKZHJpZnRmaWxlIC92YXIvbGliL2Nocm9ueS9kcmlmdAptYWtlc3RlcCAxLjAgMwpydGNzeW5jCmxvZ2RpciAvdmFyL2xvZy9jaHJvbnkK'
                  mode: 420
                  overwrite: true
                  path: /etc/chrony.conf
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: machineconfig-chrony
      namespace: example01
  5: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: 99-worker-logind
        spec:
          config:
            ignition:
              version: 3.4.0
            storage:
              files:
                - path: /etc/systemd/logind.conf.d/10-custom.conf
                  mode: 0644
                  overwrite: true
                  contents:
                    source: "data:text/plain;charset=utf-8;base64,W0xvZ2luXQpTdG9wSWRsZVNlc3Npb25TZWM9OTAwCg=="
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: machineconfig-logind
      namespace: example01
  6: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: 99-worker-mirror-by-tag-registries
        spec:
          config:
            ignition:
              version: 3.1.0
            storage:
              files:
                - contents:
                    source: data:text/plain;charset=utf-8;base64,
                  filesystem: root
                  mode: 420
                  path: /etc/containers/registries.conf.d/99-mirror-by-tag-registries.conf
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: machineconfig-mirror-registries
      namespace: example01
