manifests should match snapshot:
  1: |
    apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: kube-apiserver-cert
      namespace: example01
    spec:
      commonName: api.example01.cloud.example.com
      dnsNames:
        - api.example01.cloud.example.com
        - oauth.example01.cloud.example.com
      isCA: false
      issuerRef:
        kind: ClusterIssuer
        name: vault-issuer
      secretName: kube-apiserver-cert
  2: |
    apiVersion: v1
    data:
