  11: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-1.1.0
      name: kube-apiserver-cert
      namespace: example01
    spec:
      data:
        - remoteRef:
            key: apc-platform/p/example01-apiserver-cert
