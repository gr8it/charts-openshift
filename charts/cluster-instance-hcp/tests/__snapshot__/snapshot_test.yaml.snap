        kind: ClusterSecretStore
        name: vault
      target:
        creationPolicy: Owner
        name: ad-ldap-bind-secret
  10: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
