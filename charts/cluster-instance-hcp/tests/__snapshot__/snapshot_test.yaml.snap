        apiVersion: machineconfiguration.openshift.io/v1
        kind: KubeletConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: kubeletconfig-worker
        spec:
          kubeletConfig:
            autoSizingReserved: false
            containerLogMaxFiles: 5
            containerLogMaxSize: 20Mi
            maxPods: 350
            podsPerCore: 0
            systemReserved:
              cpu: 800m
              ephemeral-storage: 3Gi
              memory: 4Gi
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: kubeletconfig-worker
      namespace: example01
  4: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: 99-worker-chrony
        spec:
          config:
            ignition:
              version: 3.4.0
            storage:
              files:
                - contents:
                    compression: ''
                    source: 'data:text/plain;charset=utf-8;base64,c2VydmVyIDEwLjAuMC4xMSBpYnVyc3QKc2VydmVyIDEwLjAuMC4xMiBpYnVyc3QKZHJpZnRmaWxlIC92YXIvbGliL2Nocm9ueS9kcmlmdAptYWtlc3RlcCAxLjAgMwpydGNzeW5jCmxvZ2RpciAvdmFyL2xvZy9jaHJvbnkK'
                  mode: 420
                  overwrite: true
                  path: /etc/chrony.conf
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: machineconfig-chrony
      namespace: example01
  5: |
    apiVersion: v1
    data:
      config: |
        apiVersion: machineconfiguration.openshift.io/v1
        kind: MachineConfig
        metadata:
          labels:
            machineconfiguration.openshift.io/role: worker
          name: 99-worker-logind
        spec:
          config:
            ignition:
              version: 3.4.0
            storage:
              files:
                - path: /etc/systemd/logind.conf.d/10-custom.conf
                  mode: 0644
                  overwrite: true
                  contents:
                    source: "data:text/plain;charset=utf-8;base64,W0xvZ2luXQojIFNTSCBoYXJkZW5pbmcKU3RvcElkbGVTZXNzaW9uU2VjPTkwMAo="
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: cluster-instance-hcp
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: cluster-instance-hcp
        helm.sh/chart: cluster-instance-hcp-2.0.23
      name: machineconfig-logind
      namespace: example01
  6: |
