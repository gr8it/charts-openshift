{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "apc-global-overrides": { "type": "object" },
    "clusterName": { "type": "string" },
    "clusterSet": { "type": "string" },
    "releaseImage": { "type": "string" },
    "baseDomain": { "type": "string" },
    "infrastructureNamespace": { "type": "string" },
    "tolerations": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "etcd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": { "type": "string" },
        "storageSize": { "type": "string" }
      }
    },
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "upgradeType": { "type": "string", "enum": ["InPlace", "Replace"] },
        "autoRepair": { "type": "boolean" },
        "nodeLabels": { "type": "object" }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterCIDR": { "type": "string" },
        "clusterHostPrefix": { "type": "integer" },
        "serviceCIDR": { "type": "string" },
        "networkType": { "type": "string" }
      }
    },
    "nodePorts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oauthPort": { "type": "integer" },
        "konnectivityPort": { "type": "integer" },
        "ignitionPort": { "type": "integer" },
        "oidcPort": { "type": "integer" }
      }
    },
    "apiServerCert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vaultKey": { "type": "string" },
        "vaultTLSCrt": { "type": "string" },
        "vaultTLSKey": { "type": "string" }
      }
    },
    "imageProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registryHost": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "caCert": { "type": "string" }
      }
    },
    "adIntegration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idpName": { "type": "string" },
        "ldapURL": { "type": "string" },
        "bindDN": { "type": "string" },
        "caCert": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": { "type": "string" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "preferredUsername": { "type": "string" }
          }
        },
        "vaultKey": { "type": "string" },
        "vaultProperty": { "type": "string" }
      }
    },
    "ldapIntegration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idpName": { "type": "string" },
        "ldapURL": { "type": "string" },
        "bindDN": { "type": "string" },
        "caCert": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": { "type": "string" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "preferredUsername": { "type": "string" }
          }
        },
        "vaultKey": { "type": "string" },
        "vaultProperty": { "type": "string" }
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pullSecretKey": { "type": "string" },
        "pullSecretProperty": { "type": "string" },
        "sshKeyKey": { "type": "string" },
        "sshKeyProperty": { "type": "string" }
      }
    }
  }
}
