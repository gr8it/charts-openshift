{
  "title": "Operator upgrade readiness",
  "uid": "operator-readiness",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(operator_upgrade_readiness, cluster)",
        "multi": true,
        "includeAll": true
      },
      {
        "name": "package",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(operator_upgrade_readiness{cluster=~\"$cluster\"}, package)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "status",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\"}, status)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Blockers (target)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", scope=\"target\", status=\"BLOCKER\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Actions (target)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", scope=\"target\", status=~\"ACTION.*\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Warn / Unknown (target)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", scope=\"target\", status=~\"WARN|UNKNOWN\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Data age",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "time() - max(readiness_engine_last_success_timestamp_seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Operators",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", status=~\"$status\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "prometheus": true
            },
            "indexByName": {
              "cluster": 0,
              "package": 1,
              "installed": 2,
              "channel": 3,
              "scope": 4,
              "target_ocp": 5,
              "status": 6,
              "evidence": 7
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Operator drift (BEHIND, CATALOG-LAG, PIN-STALE, SUPPORT-*, BELOW-MIN)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "operator_drift_status{cluster=~\"$cluster\", package=~\"$package\", status!~\"OK|UNKNOWN\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "prometheus": true
            },
            "indexByName": {
              "cluster": 0,
              "package": 1,
              "installed": 2,
              "channel": 3,
              "status": 4
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Same operator, different versions per cluster",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (package, cluster, installed) (operator_drift_status{cluster=~\"$cluster\", package=~\"$package\", installed!=\"\"} * on(package) group_left() (operator_version_spread > 1))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "package": 0,
              "cluster": 1,
              "installed": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "package"
              },
              {
                "field": "cluster"
              }
            ]
          }
        }
      ]
    }
  ]
}
