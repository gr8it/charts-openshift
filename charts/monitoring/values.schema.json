{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platformAlertLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "team"],
      "properties": {
        "vendor": {"type": "string", "pattern": "^[a-zA-Z0-9]([-_.a-zA-Z0-9]{0,61}[a-zA-Z0-9])?$"},
        "team": {"type": "string", "pattern": "^[a-zA-Z0-9]([-_.a-zA-Z0-9]{0,61}[a-zA-Z0-9])?$"}
      }
    }
  }
}
