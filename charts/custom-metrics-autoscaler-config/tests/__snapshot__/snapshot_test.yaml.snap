manifests should match snapshot:
  1: |
    apiVersion: keda.sh/v1alpha1
    kind: KedaController
    metadata:
      labels:
        app.kubernetes.io/instance: custom-metrics-autoscaler-config
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: custom-metrics-autoscaler-config
        app.kubernetes.io/version: 2.19.0-3
        helm.sh/chart: custom-metrics-autoscaler-config-1.0.0
      name: keda
      namespace: keda
    spec:
      admissionWebhooks:
        logEncoder: console
        logLevel: info
        resources: {}
      httpAddon:
        enabled: true
        interceptor:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: interceptor
                      app.kubernetes.io/name: http-add-on
                  topologyKey: kubernetes.io/hostname
          logEncoder: console
          logLevel: info
          replicas: 2
          resources: {}
        operator:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: operator
                      app.kubernetes.io/name: http-add-on
                  topologyKey: kubernetes.io/hostname
          logEncoder: console
          logLevel: info
          replicas: 2
          resources: {}
        scaler:
          affinity:
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/component: scaler
                      app.kubernetes.io/name: http-add-on
                  topologyKey: kubernetes.io/hostname
          logEncoder: console
          logLevel: info
          replicas: 2
          resources: {}
        version: 0.14.0
      metricsServer:
        logLevel: "0"
        resources: {}
      operator:
        logEncoder: console
        logLevel: info
        resources: {}
