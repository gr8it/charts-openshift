  71: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      name: kyverno-policy-results
      namespace: apc-kyverno
    spec:
      groups:
        - name: kyverno.rules
          rules:
            - alert: KyvernoPolicyResultsError
              annotations:
                description: Kyverno policy {{ $labels.policy_name }} run with errors, please investigate kyverno logs for root cause.
                summary: Kyverno policy:{{ $labels.policy_name }} run with errors.
              expr: sum by (policy_name) (increase(kyverno_policy_results_total{rule_result="error"}[2h])) > 0
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoPolicyResultsFail
              annotations:
                description: Kyverno policy {{ $labels.policy_name }} failed, please investigate kyverno logs for root cause.
                summary: Kyverno policy {{ $labels.policy_name }} failed.
              expr: sum by (policy_name) (increase(kyverno_policy_results_total{rule_result="fail"}[2h])) > 0
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoBackgroundControllerDown
              annotations:
                description: Kyverno background controller is not running. This controller is responsible for generating resources (e.g. PrometheusRules) for existing namespaces. New and existing namespaces may be missing monitoring alerts.
                summary: Kyverno background controller is down.
              expr: absent(up{job=~".*kyverno-background-controller.*",namespace="apc-kyverno"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoAdmissionControllerDown
              annotations:
                description: Kyverno admission controller is not running. This controller is responsible for generating resources (e.g. PrometheusRules) when new namespaces are created. New namespaces will not receive monitoring alerts.
                summary: Kyverno admission controller is down.
              expr: absent(up{service="kyverno-svc-metrics",namespace="apc-kyverno"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoUpdateRequestBacklogNotDraining
              annotations:
                description: New UpdateRequests are being created but none have had their status updated in the last 30 minutes. The background controller may be stuck, overloaded, or down; generate/mutate-existing policies will stop syncing until this is resolved.
                summary: Kyverno background controller is not processing UpdateRequests.
              expr: sum(increase(kyverno_client_queries_total{client_type="kyverno",resource_kind="UpdateRequest",operation="create"}[30m])) > 0 unless sum(increase(kyverno_client_queries_total{client_type="kyverno",resource_kind="UpdateRequest",operation="update_status"}[30m])) > 0
              for: 30m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoUpdateRequestNotCleanedUp
              annotations:
                description: UpdateRequests keep being created but none have been deleted in the last 6 hours, so the backlog only grows. Left unchecked this reaches updateRequestThreshold in the Kyverno configmap and blocks all new UpdateRequest creation, silently stopping generate/mutate-existing policies from applying to new triggers.
                summary: Kyverno UpdateRequests are not being garbage collected.
              expr: sum(increase(kyverno_client_queries_total{client_type="kyverno",resource_kind="UpdateRequest",operation="create"}[6h])) > 0 unless sum(increase(kyverno_client_queries_total{client_type="kyverno",resource_kind="UpdateRequest",operation="delete"}[6h])) > 0
              for: 1h
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoUpdateRequestCreateRateHigh
              annotations:
                description: More than 500 UpdateRequests were created in the last hour, {{ $value }} in this window. At this rate the cluster risks hitting updateRequestThreshold (default 1000) and blocking new UpdateRequest creation cluster-wide.
                summary: Kyverno is creating a high volume of UpdateRequests.
              expr: sum(increase(kyverno_client_queries_total{client_type="kyverno",resource_kind="UpdateRequest",operation="create"}[1h])) > 500
              for: 15m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoCleanupControllerDown
              annotations:
                description: Kyverno cleanup controller is not running. CleanupPolicy and TTL cleanup targets will not be removed while it is down.
                summary: Kyverno cleanup controller is down.
              expr: absent(up{service="kyverno-cleanup-controller-metrics",namespace="apc-kyverno"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoReportsControllerDown
              annotations:
                description: Kyverno reports controller is not running. This controller aggregates policy/admission results into PolicyReports; while down, kyverno_policy_results_total may go stale and mask real policy failures from KyvernoPolicyResultsError/KyvernoPolicyResultsFail.
                summary: Kyverno reports controller is down.
              expr: absent(up{service="kyverno-reports-controller-metrics",namespace="apc-kyverno"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoPolicyRuleSlowExecution
              annotations:
                description: The p95 execution time for rule {{ $labels.rule_name }} in policy {{ $labels.policy_name }} has exceeded 5s over the last 15 minutes. Slow rules drag down background-scan throughput and can contribute to a growing UpdateRequest backlog.
                summary: Kyverno rule {{ $labels.policy_name }}/{{ $labels.rule_name }} is executing slowly.
              expr: histogram_quantile(0.95, sum by (le, policy_name, rule_name) (rate(kyverno_policy_execution_duration_seconds_bucket[15m]))) > 5
              for: 15m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoAdmissionReviewLatencyHigh
              annotations:
                description: The p95 admission review duration has exceeded 5s over the last 15 minutes. This risks admission webhook timeouts, which (depending on failurePolicy) can start blocking ordinary resource creates/updates cluster-wide.
                summary: Kyverno admission review latency is high.
              expr: histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[15m]))) > 5
              for: 15m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: KyvernoBackgroundPolicyDeleted
              annotations:
                description: A policy with background scanning enabled was deleted. If this generates or mutates existing resources, downstream resources will silently stop being reconciled/enforced. Verify this was intentional.
                summary: A background-enabled Kyverno policy was deleted.
              expr: increase(kyverno_policy_changes_total{policy_change_type="deleted",policy_background_mode="true"}[15m]) > 0
              for: 1m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
