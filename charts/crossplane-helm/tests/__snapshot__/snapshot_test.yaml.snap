manifests should match snapshot:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: crossplane-helm
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: crossplane-helm
        app.kubernetes.io/version: 2.1.3
        helm.sh/chart: crossplane-helm-2.3.0
      name: crossplane-helm-allow-proxy
      namespace: apc-crossplane-system
    spec:
      egress:
        - to:
            - ipBlock:
                cidr: 1.2.3.4/32
            - ipBlock:
                cidr: 1.2.3.5/32
      podSelector: {}
      policyTypes:
        - Egress
  2: |
    apiVersion: monitoring.coreos.com/v1
    kind: PodMonitor
    metadata:
      labels:
        app.kubernetes.io/instance: crossplane-helm
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: crossplane-helm
        app.kubernetes.io/version: 2.1.3
        helm.sh/chart: crossplane-helm-2.3.0
      name: crossplane-helm-providers
      namespace: apc-crossplane-system
    spec:
      namespaceSelector:
        matchNames:
          - apc-crossplane-system
      podMetricsEndpoints:
        - port: metrics
      selector:
        matchExpressions:
          - key: pkg.crossplane.io/provider
            operator: Exists
  3: |
    apiVersion: monitoring.coreos.com/v1
    kind: PodMonitor
    metadata:
      labels:
        app.kubernetes.io/instance: crossplane-helm
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: crossplane-helm
        app.kubernetes.io/version: 2.1.3
        helm.sh/chart: crossplane-helm-2.3.0
      name: crossplane-helm-rbac-manager
      namespace: apc-crossplane-system
    spec:
      namespaceSelector:
        matchNames:
          - apc-crossplane-system
      podMetricsEndpoints:
        - port: metrics
      selector:
        matchLabels:
          app: crossplane-rbac-manager
  4: |
    apiVersion: monitoring.coreos.com/v1
    kind: PodMonitor
    metadata:
      labels:
        app.kubernetes.io/instance: crossplane-helm
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: crossplane-helm
        app.kubernetes.io/version: 2.1.3
        helm.sh/chart: crossplane-helm-2.3.0
      name: crossplane-helm
      namespace: apc-crossplane-system
    spec:
      namespaceSelector:
        matchNames:
          - apc-crossplane-system
      podMetricsEndpoints:
        - port: metrics
      selector:
        matchLabels:
          app: crossplane
  5: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      labels:
        app.kubernetes.io/instance: crossplane-helm
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: crossplane-helm
        app.kubernetes.io/version: 2.1.3
        helm.sh/chart: crossplane-helm-2.3.0
      name: crossplane-helm
      namespace: apc-crossplane-system
    spec:
      groups:
        - name: crossplane.rules
          rules:
            - alert: CrossplaneControllerDown
              annotations:
                description: Crossplane controller pod has been down for more than 10 minutes
                summary: Crossplane controller is not running
              expr: |
                absent(up{job="apc-crossplane-system/crossplane-helm"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: CrossplaneReconciliationErrors
              annotations:
                description: Crossplane controller has reconciliation errors for controller {{ $labels.controller }}
                summary: Crossplane reconciliation errors detected
              expr: |
                increase(controller_runtime_reconcile_errors_total{job="apc-crossplane-system/crossplane-helm"}[15m]) > 0
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: CrossplaneRBACManagerDown
              annotations:
                description: Crossplane RBAC manager pod has been down for more than 10 minutes
                summary: Crossplane RBAC manager is not running
              expr: |
                absent(up{job="apc-crossplane-system/crossplane-helm-rbac-manager"}) == 1
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: CrossplaneProviderDown
              annotations:
                description: Crossplane provider deployment {{ $labels.deployment }} has no available replicas for more than 10 minutes
                summary: Crossplane provider is not running
              expr: |
                kube_deployment_status_replicas_available{namespace="apc-crossplane-system", deployment=~".+-provider-.+"} == 0
              for: 10m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: CrossplaneManagedResourcesNotSynced
              annotations:
                description: '{{ $value }} managed resources of {{ $labels.gvk }} are not synced for more than 30 minutes. Check status.conditions of the resources and the provider credentials (ProviderConfig).'
                summary: Crossplane managed resources are not synced
              expr: |
                max by (gvk) (crossplane_managed_resource_exists{job="apc-crossplane-system/crossplane-helm-providers"})
                  - max by (gvk) (crossplane_managed_resource_synced{job="apc-crossplane-system/crossplane-helm-providers"}) > 0
              for: 30m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
