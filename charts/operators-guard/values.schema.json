{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "operators-guard values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values to be accessed by all (sub)charts.",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string",
      "description": "Overrides chart name used for resource names and app.kubernetes.io/name."
    },
    "image": {
      "type": "string",
      "description": "readiness-engine container image (default tag 0.12.0).",
      "minLength": 1
    },
    "interval": {
      "type": "string",
      "description": "Collector interval: hours, minutes and seconds in this order, each at most once (e.g. 1h, 30m, 1h30m).",
      "pattern": "^([0-9]+h([0-9]+m)?([0-9]+s)?|[0-9]+m([0-9]+s)?|[0-9]+s)$"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "description": "Write an offline work order alongside the cached snapshot."}
      }
    },
    "historyKeep": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of report-only history entries kept in the pod cache (default 24; 0 disables)."
    },
    "policy": {
      "type": "object",
      "description": "Readiness policy passed unchanged; workflow and brief scope are validated by the engine too.",
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "eus",
            "next-minor",
            "pinned"
          ]
        },
        "minVersions": {
          "type": "object",
          "description": "Package -> minimum installed version (major.minor.patch); below it = BELOW-MIN.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDaysBehind": {
              "type": "integer",
              "minimum": 0,
              "description": "A newer version in the channel for longer than this = BEHIND (default 90)."
            },
            "supportWarnDays": {
              "type": "integer",
              "minimum": 0,
              "description": "Vendor support ends within this many days = SUPPORT-ENDING (default 180)."
            }
          }
        },
        "owners": {
          "type": ["object", "null"],
          "description": "Package -> operator owner.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "defaultOwner": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Owner for packages without a mapping or exception (default: unassigned)."
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chartsRepo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "remote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "baseBranch": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "default": "main"
                }
              }
            },
            "confRepos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "clusters": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "envs": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            },
            "ticketPrefix": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "push": {
              "type": "string",
              "enum": [
                "ask",
                "allowed"
              ],
              "default": "ask"
            }
          },
          "description": "Optional work-order destinations; missing fields require user answers. Cluster sets must be disjoint (checked by engine)."
        },
        "brief": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "excludeClusters": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": "Exclude targets and gates only; known installed CSVs remain in work-order versions. Unknown names fail generation."
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional OCI repository in hub Quay for the snapshot; empty = no push."
        },
        "pushSecret": {
          "type": [
            "string",
            "null"
          ],
          "description": "Existing dockerconfigjson Secret with Quay push credentials; required when repository is set."
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instanceName": {
          "type": "string",
          "description": "Value of the dashboards label on the Grafana instance.",
          "minLength": 1
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Names of existing dockerconfigjson Secrets used to pull the image.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodeSelector": {
      "type": "object",
      "description": "Optional pod nodeSelector.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "apc-global-overrides": {
      "type": "object",
      "description": "Values for the apc-global-overrides library dependency."
    }
  }
}
