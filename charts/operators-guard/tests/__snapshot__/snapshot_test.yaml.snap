manifests should match snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
    rules:
      - apiGroups:
          - config.openshift.io
        resourceNames:
          - version
        resources:
          - clusterversions
        verbs:
          - get
      - apiGroups:
          - apiserver.openshift.io
        resources:
          - apirequestcounts
        verbs:
          - list
      - apiGroups:
          - cluster.open-cluster-management.io
        resources:
          - managedclusters
        verbs:
          - list
      - apiGroups:
          - operators.coreos.com
        resources:
          - subscriptions
          - clusterserviceversions
        verbs:
          - list
      - apiGroups:
          - operators.coreos.com
        resources:
          - installplans
        verbs:
          - get
      - apiGroups:
          - apps
        resources:
          - deployments
        verbs:
          - list
      - apiGroups:
          - policy.open-cluster-management.io
        resources:
          - operatorpolicies
        verbs:
          - list
      - apiGroups:
          - view.open-cluster-management.io
        resources:
          - managedclusterviews
        verbs:
          - get
          - create
          - delete
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: operators-guard
    subjects:
      - kind: ServiceAccount
        name: operators-guard
        namespace: apc-operators-guard
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
      namespace: apc-operators-guard
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: operators-guard
          app.kubernetes.io/name: operators-guard
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/policy: 3139de18bc5b7bfadb9661f4cfb876bf65b5f140c6c6f332228e408a5cc8eb7f
          labels:
            app.kubernetes.io/instance: operators-guard
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: operators-guard
            app.kubernetes.io/version: 0.7.4
            helm.sh/chart: operators-guard-0.7.1
        spec:
          containers:
            - args:
                - collect
                - --loop
                - --interval=1h
                - --policy=/etc/readiness/policy.yaml
                - --snapshot-repository=quay-registry.apps.hub01.example.com/apc/operators-guard-snapshot
                - --cache-dir=/var/cache/readiness
                - --history-keep=24
                - --listen=:8080
              env:
                - name: HTTPS_PROXY
                  value: http://proxy.example.com:3128
                - name: HTTP_PROXY
                  value: http://proxy.example.com:3128
                - name: NO_PROXY
                  value: .example.com,.svc,.cluster.local,$(KUBERNETES_SERVICE_HOST)
                - name: SNAPSHOT_AUTH_FILE
                  value: /run/secrets/snapshot-push/.dockerconfigjson
                - name: SEARCH_API_URL
                  value: https://search-search-api.open-cluster-management.svc:4010/searchapi/graphql
                - name: SEARCH_API_CA_FILE
                  value: /etc/pki/service-ca/service-ca.crt
              image: ghcr.io/gr8it/operators-guard:0.7.4
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: metrics
                periodSeconds: 30
              name: collector
              ports:
                - containerPort: 8080
                  name: metrics
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: metrics
              resources:
                limits:
                  cpu: "1"
                  memory: 2Gi
                requests:
                  cpu: 200m
                  memory: 1Gi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /etc/readiness
                  name: policy
                  readOnly: true
                - mountPath: /run/secrets/snapshot-push
                  name: snapshot-push
                  readOnly: true
                - mountPath: /etc/pki/service-ca
                  name: service-ca
                  readOnly: true
                - mountPath: /var/cache/readiness
                  name: cache
                - mountPath: /tmp
                  name: tmp
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: operators-guard
          volumes:
            - configMap:
                name: operators-guard-policy
              name: policy
            - name: snapshot-push
              secret:
                secretName: operators-guard-quay-push
            - configMap:
                name: openshift-service-ca.crt
              name: service-ca
            - emptyDir:
                sizeLimit: 5Gi
              name: cache
            - emptyDir: {}
              name: tmp
  4: |
    apiVersion: grafana.integreatly.org/v1beta1
    kind: GrafanaDashboard
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
      namespace: apc-operators-guard
    spec:
      allowCrossNamespaceImport: true
      instanceSelector:
        matchLabels:
          dashboards: apc-grafana
      json: |
        {
          "title": "Operator upgrade readiness",
          "uid": "operators-guard",
          "schemaVersion": 39,
          "refresh": "5m",
          "time": {
            "from": "now-7d",
            "to": "now"
          },
          "templating": {
            "list": [
              {
                "name": "datasource",
                "type": "datasource",
                "query": "prometheus"
              },
              {
                "name": "cluster",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
                },
                "query": "label_values(operator_upgrade_readiness, cluster)",
                "multi": true,
                "includeAll": true
              },
              {
                "name": "package",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
                },
                "query": "label_values(operator_upgrade_readiness{cluster=~\"$cluster\"}, package)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true,
                "allValue": ".*"
              },
              {
                "name": "owner",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
                },
                "query": "label_values(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\"}, owner)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true,
                "allValue": ".*"
              },
              {
                "name": "status",
                "type": "query",
                "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
                },
                "query": "label_values(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"}, status)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true,
                "allValue": ".*"
              }
            ]
          },
          "panels": [
            {
              "type": "stat",
              "title": "Blockers (target)",
              "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", scope=\"target\", status=\"BLOCKER\"}) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Actions (target)",
              "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", scope=\"target\", status=~\"ACTION.*\"}) or vector(0)"
                }
              ]
            },
            {
              "type": "stat",
              "title": "Warn / Unknown (target)",
              "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", scope=\"target\", status=~\"WARN|UNKNOWN\"}) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Data age",
              "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "time() - max(readiness_engine_last_success_timestamp_seconds)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 10800
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "table",
              "title": "Operators",
              "gridPos": {
                "x": 0,
                "y": 8,
                "w": 24,
                "h": 16
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "operator_upgrade_readiness{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", status=~\"$status\"}",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Value": true,
                      "__name__": true,
                      "container": true,
                      "endpoint": true,
                      "instance": true,
                      "job": true,
                      "pod": true,
                      "service": true,
                      "prometheus": true
                    },
                    "indexByName": {
                      "cluster": 0,
                      "package": 1,
                      "installed": 2,
                      "channel": 3,
                      "scope": 4,
                      "target_ocp": 5,
                      "status": 6,
                      "evidence": 7
                    }
                  }
                }
              ]
            },
            {
              "type": "table",
              "title": "Operator drift (BEHIND, CATALOG-LAG, PIN-STALE, SUPPORT-*, BELOW-MIN)",
              "gridPos": {
                "x": 0,
                "y": 24,
                "w": 24,
                "h": 12
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "operator_drift_status{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", status!~\"OK|UNKNOWN\"}",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Value": true,
                      "__name__": true,
                      "container": true,
                      "endpoint": true,
                      "instance": true,
                      "job": true,
                      "pod": true,
                      "service": true,
                      "prometheus": true
                    },
                    "indexByName": {
                      "cluster": 0,
                      "package": 1,
                      "installed": 2,
                      "channel": 3,
                      "status": 4
                    }
                  }
                }
              ]
            },
            {
              "type": "table",
              "title": "Same operator, different versions per cluster",
              "gridPos": {
                "x": 0,
                "y": 36,
                "w": 24,
                "h": 10
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "max by (package, cluster, installed) (operator_drift_status{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\", installed!=\"\"} * on(package) group_left() (operator_version_spread > 1))",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "Value": true,
                      "__name__": true
                    },
                    "indexByName": {
                      "package": 0,
                      "cluster": 1,
                      "installed": 2
                    }
                  }
                },
                {
                  "id": "sortBy",
                  "options": {
                    "sort": [
                      {
                        "field": "package"
                      },
                      {
                        "field": "cluster"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "stat",
              "title": "Prediction mismatches",
              "gridPos": {
                "x": 0,
                "y": 4,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(operator_prediction_mismatch{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"} == 1) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Stale pending InstallPlans",
              "gridPos": {
                "x": 6,
                "y": 4,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(operator_prediction_stale_plan{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"} == 1) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Exceptions expiring (0-29 d)",
              "gridPos": {
                "x": 12,
                "y": 4,
                "w": 3,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(readiness_exception_days_left{package=~\"$package\", owner=~\"$owner\"} < 30 >= 0) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Expired exceptions",
              "gridPos": {
                "x": 15,
                "y": 4,
                "w": 3,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "count(readiness_exception_days_left{package=~\"$package\", owner=~\"$owner\"} < 0) or vector(0)"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "stat",
              "title": "Prediction not comparable (UNKNOWN)",
              "gridPos": {
                "x": 18,
                "y": 4,
                "w": 6,
                "h": 4
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "max(readiness_engine_predictions{status=\"UNKNOWN\"})"
                }
              ],
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "table",
              "title": "Prediction check (non-MATCH)",
              "gridPos": {
                "x": 0,
                "y": 46,
                "w": 24,
                "h": 12
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "refId": "A",
                  "expr": "label_join((label_replace(operator_prediction_mismatch{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"} == 1, \"status\", \"MISMATCH\", \"package\", \".*\") or label_replace(operator_prediction_stale_plan{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"} == 1, \"status\", \"STALE-PLAN\", \"package\", \".*\")), \"row_key\", \"/\", \"cluster\", \"namespace\", \"subscription\")",
                  "format": "table",
                  "instant": true
                },
                {
                  "refId": "B",
                  "expr": "sum by (row_key) (label_join(operator_prediction_plan_age_days{cluster=~\"$cluster\", package=~\"$package\", owner=~\"$owner\"}, \"row_key\", \"/\", \"cluster\", \"namespace\", \"subscription\"))",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "joinByField",
                  "options": {
                    "byField": "row_key",
                    "mode": "outer"
                  }
                },
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "__name__": true,
                      "row_key": true,
                      "Value #A": true,
                      "channel": true,
                      "job": true,
                      "instance": true,
                      "pod": true,
                      "service": true,
                      "endpoint": true
                    },
                    "indexByName": {
                      "cluster": 0,
                      "namespace": 1,
                      "subscription": 2,
                      "package": 3,
                      "installed": 4,
                      "owner": 5,
                      "status": 6,
                      "Value #B": 7
                    },
                    "renameByName": {
                      "Value #B": "Plan age (days)"
                    }
                  }
                },
                {
                  "id": "sortBy",
                  "options": {
                    "sort": [
                      {
                        "field": "Plan age (days)",
                        "desc": true
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "table",
              "title": "Exceptions (days left)",
              "gridPos": {
                "x": 0,
                "y": 58,
                "w": 12,
                "h": 10
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "readiness_exception_days_left{package=~\"$package\", owner=~\"$owner\"}",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "__name__": true,
                      "job": true,
                      "instance": true,
                      "namespace": true,
                      "pod": true,
                      "service": true,
                      "endpoint": true,
                      "container": true
                    },
                    "indexByName": {
                      "package": 0,
                      "owner": 1,
                      "Value": 2
                    },
                    "renameByName": {
                      "Value": "Days left"
                    }
                  }
                },
                {
                  "id": "sortBy",
                  "options": {
                    "sort": [
                      {
                        "field": "Days left",
                        "desc": false
                      }
                    ]
                  }
                }
              ],
              "fieldConfig": {
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Days left"
                    },
                    "properties": [
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": null
                            },
                            {
                              "color": "orange",
                              "value": 0
                            },
                            {
                              "color": "green",
                              "value": 30
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "table",
              "title": "Sources",
              "gridPos": {
                "x": 12,
                "y": 58,
                "w": 12,
                "h": 10
              },
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "targets": [
                {
                  "expr": "max by (source) (readiness_engine_source_up)",
                  "format": "table",
                  "instant": true
                }
              ],
              "transformations": [
                {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Time": true,
                      "__name__": true,
                      "job": true,
                      "instance": true,
                      "namespace": true,
                      "pod": true,
                      "service": true,
                      "endpoint": true,
                      "container": true
                    },
                    "indexByName": {
                      "source": 0,
                      "Value": 1
                    },
                    "renameByName": {
                      "Value": "Up"
                    }
                  }
                }
              ],
              "fieldConfig": {
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Up"
                    },
                    "properties": [
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": null
                            },
                            {
                              "color": "green",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard-packagemanifests
      namespace: openshift-marketplace
    rules:
      - apiGroups:
          - packages.operators.coreos.com
        resources:
          - packagemanifests
        verbs:
          - get
  6: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard-packagemanifests
      namespace: openshift-marketplace
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: operators-guard-packagemanifests
    subjects:
      - kind: ServiceAccount
        name: operators-guard
        namespace: apc-operators-guard
  7: |
    apiVersion: v1
    data:
      policy.yaml: |
        defaultOwner: unassigned
        drift:
          maxDaysBehind: 90
          supportWarnDays: 180
        exceptions:
        - expires: "2027-03-31"
          owner: platform-team
          package: external-secrets
          reason: upstream, no OCP support matrix
        graph:
          conditionalRisks: block
        lockstep:
        - kubevirt-hyperconverged
        - odf-operator
        minVersions:
          openshift-gitops-operator: 1.21.0
        owners:
          openshift-gitops-operator: platform-team
        strategy: eus
        unsupportedWindow:
          allow:
          - redhat-oadp-operator
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard-policy
      namespace: apc-operators-guard
  8: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard-rules
      namespace: apc-operators-guard
    spec:
      groups:
        - name: operators-guard.rules
          rules:
            - alert: OperatorUnsupportedNow
              annotations:
                description: '{{ $labels.package }} {{ $labels.installed }} on cluster {{ $labels.cluster }} is not supported on the current OCP minor (evidence: {{ $labels.evidence }}).'
                owner: '{{ $labels.owner }}'
                summary: Operator is not supported on the running OpenShift version
              expr: operator_upgrade_readiness{scope="current", status="BLOCKER"} == 1
              for: 1h
              labels:
                owner: '{{ $labels.owner }}'
                severity: critical
                team: platform
                vendor: aspecta
            - alert: OperatorUpgradeBlocker
              annotations:
                description: '{{ $labels.package }} {{ $labels.installed }} on cluster {{ $labels.cluster }} blocks upgrade to OCP {{ $labels.target_ocp }} (evidence: {{ $labels.evidence }}).'
                owner: '{{ $labels.owner }}'
                summary: Operator blocks the OpenShift upgrade
              expr: operator_upgrade_readiness{scope="target", status="BLOCKER"} == 1
              for: 1h
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorSupportEnded
              annotations:
                description: '{{ $labels.package }} {{ $labels.installed }} on cluster {{ $labels.cluster }}: vendor support of this version line has ended.'
                owner: '{{ $labels.owner }}'
                summary: Vendor support of the installed operator version has ended
              expr: operator_drift_status{status="SUPPORT-ENDED"} == 1
              for: 24h
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorBelowMinVersion
              annotations:
                description: '{{ $labels.package }} {{ $labels.installed }} on cluster {{ $labels.cluster }} is below policy.minVersions.'
                owner: '{{ $labels.owner }}'
                summary: Installed operator is below the version the platform requires
              expr: operator_below_min_version == 1
              for: 1h
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorPinStale
              annotations:
                description: The OperatorPolicy of {{ $labels.package }} on cluster {{ $labels.cluster }} (installed {{ $labels.installed }}) lacks the channel head or the pending InstallPlan CSV in versions[].
                owner: '{{ $labels.owner }}'
                summary: OperatorPolicy versions[] does not cover the newest catalog version
              expr: operator_pin_stale == 1
              for: 7d
              labels:
                owner: '{{ $labels.owner }}'
                severity: info
                team: platform
                vendor: aspecta
            - alert: OperatorVersionBehind
              annotations:
                description: '{{ $labels.package }} {{ $labels.installed }} on cluster {{ $labels.cluster }} is behind its channel.'
                owner: '{{ $labels.owner }}'
                summary: Newer operator version has been available for longer than policy.drift.maxDaysBehind
              expr: operator_drift_status{status="BEHIND"} == 1
              for: 7d
              labels:
                owner: '{{ $labels.owner }}'
                severity: info
                team: platform
                vendor: aspecta
            - alert: OperatorPredictionMismatch
              annotations:
                description: '{{ $labels.package }} on cluster {{ $labels.cluster }} has a CSV that is not a valid next step from the installed CSV; review the InstallPlan and channel graph before approval.'
                owner: '{{ $labels.owner }}'
                summary: Observed OLM CSV is outside the channel graph
              expr: operator_prediction_mismatch == 1
              for: 1h
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorStalePendingInstallPlan
              annotations:
                description: '{{ $labels.package }} on cluster {{ $labels.cluster }}: pending InstallPlan was resolved against an older catalog head; review and approve or delete it; OLM then re-resolves.'
                owner: '{{ $labels.owner }}'
                summary: Pending InstallPlan was resolved against an older catalog head
              expr: operator_prediction_stale_plan == 1 and on(cluster, namespace, subscription, package, installed, channel, owner) operator_prediction_plan_age_days > 14
              for: 1h
              labels:
                owner: '{{ $labels.owner }}'
                severity: info
                team: platform
                vendor: aspecta
            - alert: OperatorStalePendingInstallPlanNoTimestamp
              annotations:
                description: '{{ $labels.package }} on cluster {{ $labels.cluster }} has a stale pending InstallPlan with no readable creation time; review its channel and plan before approval.'
                owner: '{{ $labels.owner }}'
                summary: Pending InstallPlan has no readable creation time
              expr: operator_prediction_stale_plan == 1 unless on(cluster, namespace, subscription, package, installed, channel, owner) operator_prediction_plan_age_days
              for: 7d
              labels:
                owner: '{{ $labels.owner }}'
                severity: info
                team: platform
                vendor: aspecta
            - alert: OperatorExceptionExpiring
              annotations:
                description: Exception for {{ $labels.package }} expires in {{ $value }} days.
                owner: '{{ $labels.owner }}'
                summary: Operator exception expires within 30 days
              expr: readiness_exception_days_left < 30 and readiness_exception_days_left >= 0
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorExceptionExpired
              annotations:
                description: Exception for {{ $labels.package }} has expired ({{ $value }} days left).
                owner: '{{ $labels.owner }}'
                summary: Operator exception has expired
              expr: readiness_exception_days_left < 0
              labels:
                owner: '{{ $labels.owner }}'
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorReadinessCollectStale
              annotations:
                description: readiness-engine in apc-operators-guard has not completed a successful collect for more than 3 hours; readiness results and the CI snapshot are outdated.
                summary: Operator readiness data is stale
              expr: time() - readiness_engine_last_success_timestamp_seconds{namespace="apc-operators-guard"} > 3 * 3600
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorReadinessNoData
              annotations:
                description: readiness-engine in apc-operators-guard has not completed any successful collect for 30 minutes (pod not ready or not scraped). Check the pod logs.
                summary: Operator readiness collector has no data
              expr: absent(readiness_engine_last_success_timestamp_seconds{namespace="apc-operators-guard"})
              for: 30m
              labels:
                severity: warning
                team: platform
                vendor: aspecta
            - alert: OperatorReadinessSourceDown
              annotations:
                description: Source {{ $labels.source }} has been unavailable for 6 hours; affected results are reported as UNKNOWN.
                summary: Operator readiness data source is unavailable
              expr: readiness_engine_source_up{namespace="apc-operators-guard"} == 0
              for: 6h
              labels:
                severity: warning
                team: platform
                vendor: aspecta
  9: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
      namespace: apc-operators-guard
    spec:
      ports:
        - name: metrics
          port: 8080
          protocol: TCP
          targetPort: metrics
      selector:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/name: operators-guard
  10: |
    apiVersion: monitoring.coreos.com/v1
    kind: ServiceMonitor
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
      namespace: apc-operators-guard
    spec:
      endpoints:
        - interval: 5m
          port: metrics
      selector:
        matchLabels:
          app.kubernetes.io/instance: operators-guard
          app.kubernetes.io/name: operators-guard
  11: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: operators-guard
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: operators-guard
        app.kubernetes.io/version: 0.7.4
        helm.sh/chart: operators-guard-0.7.1
      name: operators-guard
      namespace: apc-operators-guard
