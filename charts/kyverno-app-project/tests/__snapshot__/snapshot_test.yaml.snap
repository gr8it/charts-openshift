                    - (( variables.name ))
                providerConfigRef:
                  name: vault-hub-provider-config
      matchConditions:
        - expression: 'cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "") != "" && dyn(resource.Get("ldap.vault.upbound.io/v1alpha1", "authbackendgroups", "", "apc-" + (cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "")).substring(0, 1) + "-" + object.metadata.name + "-opr")) == null'
          name: cluster-name-resolved-and-authbackendgroup-missing
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      variables:
        - expression: 'cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "")'
          name: clusterName
        - expression: variables.clusterName.substring(0, 1)
          name: clusterInitial
        - expression: '"apc-" + variables.clusterInitial + "-" + object.metadata.name + "-opr"'
          name: name
  16: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Monitoring
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Patch Namespace labels from the project metadata ConfigMap
      labels:
        app.kubernetes.io/instance: kyverno-app-project
        app.kubernetes.io/managed-by: ArgoCD
        app.kubernetes.io/name: kyverno-app-project
        helm.sh/chart: kyverno-app-project-2.0.0
      name: app-project-namespace-metadata
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConditions:
        - expression: size(variables.labelKeys) > 0
          name: has-valid-labels
      matchConstraints:
        namespaceSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resourceNames:
              - project-metadata
            resources:
              - configmaps
      mutations:
        - applyConfiguration:
            expression: |-
              Object{
                metadata: Object.metadata{
                  labels: variables.labels
                }
              }
          patchType: ApplyConfiguration
      targetMatchConstraints:
        expression: resource.Get("v1", "namespaces", "", object.metadata.namespace)
      variables:
        - expression: |-
            request.object.?data.orValue({}).filter(k,
              k.matches('^[a-zA-Z0-9]([-_.a-zA-Z0-9]{0,61}[a-zA-Z0-9])?$') &&
              request.object.data[k].matches('^[a-zA-Z0-9]([-_.a-zA-Z0-9]{0,61}[a-zA-Z0-9])?$') &&
              !k.startsWith('apc.') && !k.contains('kubernetes') && !k.contains('openshift') && !k.contains('k8s'))
          name: labelKeys
        - expression: |-
            transform.listObjToMap(
              variables.labelKeys.map(k, {"key": k}),
              variables.labelKeys.map(k, {"value": request.object.data[k]}),
              "key", "value")
          name: labels
  17: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Monitoring
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Mirror team and vendor Namespace labels on existing Services
      labels:
        app.kubernetes.io/instance: kyverno-app-project
        app.kubernetes.io/managed-by: ArgoCD
        app.kubernetes.io/name: kyverno-app-project
        helm.sh/chart: kyverno-app-project-2.0.0
      name: app-project-service-metadata-existing
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConditions:
        - expression: variables.team != '' && variables.vendor != ''
          name: namespace-has-team-and-vendor
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      mutations:
        - applyConfiguration:
            expression: '''team'' in object.metadata.?labels.orValue({}) ? Object{} : Object{metadata: Object.metadata{labels: {"team": variables.team}}}'
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: '''vendor'' in object.metadata.?labels.orValue({}) ? Object{} : Object{metadata: Object.metadata{labels: {"vendor": variables.vendor}}}'
          patchType: ApplyConfiguration
      targetMatchConstraints:
        expression: resource.List("v1", "services", object.metadata.name)
      variables:
        - expression: request.object.metadata.?labels[?'team'].orValue('')
          name: team
        - expression: request.object.metadata.?labels[?'vendor'].orValue('')
          name: vendor
  18: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Monitoring
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Mirror team and vendor Namespace labels on Services
      labels:
        app.kubernetes.io/instance: kyverno-app-project
        app.kubernetes.io/managed-by: ArgoCD
        app.kubernetes.io/name: kyverno-app-project
        helm.sh/chart: kyverno-app-project-2.0.0
      name: app-project-service-metadata
    spec:
      matchConditions:
        - expression: variables.team != '' && variables.vendor != ''
          name: namespace-has-team-and-vendor
      matchConstraints:
        namespaceSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - services
      mutations:
        - applyConfiguration:
            expression: '''team'' in object.metadata.?labels.orValue({}) ? Object{} : Object{metadata: Object.metadata{labels: {"team": variables.team}}}'
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: '''vendor'' in object.metadata.?labels.orValue({}) ? Object{} : Object{metadata: Object.metadata{labels: {"vendor": variables.vendor}}}'
          patchType: ApplyConfiguration
      variables:
        - expression: namespaceObject.metadata.?labels[?'team'].orValue('')
          name: team
        - expression: namespaceObject.metadata.?labels[?'vendor'].orValue('')
          name: vendor
  19: |
    apiVersion: policies.kyverno.io/v1
    kind: ValidatingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Monitoring
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Namespace
        policies.kyverno.io/title: Report application Namespaces without a project metadata ConfigMap
      labels:
        app.kubernetes.io/instance: kyverno-app-project
        app.kubernetes.io/managed-by: ArgoCD
        app.kubernetes.io/name: kyverno-app-project
        helm.sh/chart: kyverno-app-project-2.0.0
      name: app-project-require-metadata-configmap
    spec:
      evaluation:
        admission:
          enabled: false
        background:
          enabled: true
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      validationActions:
        - Audit
      validations:
        - expression: dyn(resource.Get("v1", "configmaps", object.metadata.name, "project-metadata")) != null
          messageExpression: '"Namespace ''" + object.metadata.name + "'' has no ''project-metadata'' ConfigMap, so the project has no owner and its metrics are still reported under the platform defaults. Create the ConfigMap in the namespace with proper labels."'
