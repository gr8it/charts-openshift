  14: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: project
        policies.kyverno.io/title: Setup vault project policy for operator role
      labels:
        app.kubernetes.io/instance: kyverno-app-project
        app.kubernetes.io/managed-by: ArgoCD
        app.kubernetes.io/name: kyverno-app-project
        helm.sh/chart: kyverno-app-project-2.0.0
      name: app-project-vault-groups-opr-policy
    spec:
      evaluation:
        generateExisting:
          enabled: true
        skipBackgroundRequests: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: vault.vault.upbound.io/v1alpha1
              kind: Policy
              metadata:
                name: (( variables.name ))
              spec:
                deletionPolicy: Delete
                forProvider:
                  name: (( variables.name ))
                  policy: |
                    # Access to secrets path (v1)
                    path "apc/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["create", "read", "update", "delete", "list", "patch"]
                    }

                    # Access to secrets path (v2)
                    path "apc/data/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["create", "read", "update", "delete", "list", "patch"]
                    }

                    # Access to metadata (v2)
                    path "apc/metadata/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["create", "read", "update", "delete", "list", "patch"]
                    }

                    # Allow version delete
                    path "apc/delete/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["update"]
                    }

                    # Allow version destroy
                    path "apc/destroy/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["update"]
                    }

                    # Allow version undelete
                    path "apc/undelete/(( variables.clusterInitial ))/(( object.metadata.name ))/*" {
                      capabilities = ["update"]
                    }

                    # Allow browsing to the project secrets
                    path "apc/metadata/" {
                      capabilities = ["list"]
                    }
                    path "apc/metadata/(( variables.clusterInitial ))" {
                      capabilities = ["list"]
                    }

                providerConfigRef:
                  name: vault-hub-provider-config
      matchConditions:
        - expression: 'cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "") != "" && dyn(resource.Get("vault.vault.upbound.io/v1alpha1", "policies", "", "apc-" + (cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "")).substring(0, 1) + "-" + object.metadata.name + "-opr")) == null'
          name: cluster-name-resolved-and-policie-missing
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      variables:
        - expression: 'cel.bind(parts, cel.bind(route, dyn(resource.Get("route.openshift.io/v1", "routes", "openshift-console", "console")), route == null ? "" : route.spec.host).split("."), size(parts) > 2 ? parts[2] : "")'
          name: clusterName
        - expression: variables.clusterName.substring(0, 1)
          name: clusterInitial
        - expression: '"apc-" + variables.clusterInitial + "-" + object.metadata.name + "-opr"'
          name: name
  15: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Secrets
