{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nodeNetworkConfigurationPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "nodeSelector": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "desiredState": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "interfaces"
            ]
          }
        },
        "required": [
          "name",
          "nodeSelector",
          "desiredState"
        ]
      }
    },
    "additionalNetworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "rawCNIConfig": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "namespace",
          "type",
          "rawCNIConfig"
        ]
      }
    },
    "storageCluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "namespace",
        "resources"
      ]
    },
    "machineConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": true
        },
        "configMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "name",
            "namespace"
          ]
        }
      },
      "required": [
        "name",
        "labels",
        "spec",
        "configMap"
      ]
    },
    "global": {
      "type": "object"
    }
  },
  "required": [
    "nodeNetworkConfigurationPolicies",
    "additionalNetworks",
    "storageCluster",
    "machineConfig"
  ]
}
