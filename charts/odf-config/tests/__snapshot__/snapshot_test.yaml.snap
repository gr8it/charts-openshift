renders the Network additionalNetworks when set:
  1: |
    apiVersion: operator.openshift.io/v1
    kind: Network
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: ServerSideApply=true
      name: cluster
    spec:
      additionalNetworks:
        - name: odf
          namespace: openshift-storage
          rawCNIConfig: |-
            {
              "cniVersion": "0.3.1",
              "name": "odf",
              "type": "macvlan",
              "master": "bond1.100",
              "mode": "bridge",
              "ipam": {
                "type": "whereabouts",
                "range": "192.0.2.0/25",
                "range_start": "192.0.2.10",
                "range_end": "192.0.2.126"
              }
            }
          type: Raw
