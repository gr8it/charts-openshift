{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cluster-observability-operator values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values to be accessed by all (sub)charts.",
      "additionalProperties": true
    },
    "acm-operatorpolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operatorGroup",
        "subscription",
        "upgradeApproval",
        "versions"
      ],
      "properties": {
        "subscription": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "channel",
            "name",
            "namespace",
            "source",
            "sourceNamespace",
            "startingCSV"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sourceNamespace": {
              "type": "string",
              "minLength": 1
            },
            "startingCSV": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "upgradeApproval": {
          "type": "string",
          "enum": [
            "Automatic"
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operatorGroup": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "name",
            "namespace"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
