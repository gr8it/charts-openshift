{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dynatrace-instance values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiUrl": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      ],
      "description": "Dynatrace environment API URL."
    },
    "hostGroup": {
      "type": "string",
      "description": "OneAgent host group. Defaults to the cluster name, or the Helm release name if no cluster name is configured."
    },
    "apc-global-overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Values for the apc-global-overrides chart dependency."
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "description": "Global values supplied by the configuration repository."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations applied to the DynaKube resource."
    },
    "skipCertCheck": {
      "type": "boolean",
      "description": "Whether to skip TLS certificate validation for the Dynatrace API connection."
    },
    "metadataEnrichment": {
      "type": "object",
      "additionalProperties": true,
      "description": "DynaKube metadata enrichment configuration."
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refreshInterval": {
          "type": "string",
          "minLength": 1,
          "description": "Interval for refreshing Dynatrace tokens from the external secret store."
        }
      }
    },
    "activeGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "routing",
              "kubernetes-monitoring",
              "metrics-ingest",
              "dynatrace-api"
            ]
          },
          "uniqueItems": true
        },
        "group": {
          "type": "string",
          "description": "ActiveGate group. Defaults to os- followed by the cluster name, or the Helm release name if no cluster name is configured."
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/definitions/resourceRequirements"
            },
            "limits": {
              "$ref": "#/definitions/resourceRequirements"
            }
          },
          "description": "ActiveGate CPU and memory requests and limits."
        }
      },
      "description": "DynaKube ActiveGate configuration."
    }
  },
  "definitions": {
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}