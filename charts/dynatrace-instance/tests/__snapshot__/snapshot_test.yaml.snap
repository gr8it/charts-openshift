manifests should match snapshot:
  1: |
    apiVersion: dynatrace.com/v1beta6
    kind: DynaKube
    metadata:
      annotations:
        feature.dynatrace.com/automatic-kubernetes-api-monitoring-cluster-name: test-cluster
      labels:
        app.kubernetes.io/instance: apc-dynatrace
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: dynatrace-instance
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: dynatrace-instance-1.0.4
      name: test-cluster
      namespace: apc-dynatrace
    spec:
      activeGate:
        capabilities:
          - routing
          - kubernetes-monitoring
          - metrics-ingest
          - dynatrace-api
        group: os-test-cluster
        resources:
          limits:
            cpu: 1000m
            memory: 1.5Gi
          requests:
            cpu: 500m
            memory: 512Mi
      apiUrl: https://abc12345.live.dynatrace.com/api
      metadataEnrichment:
        enabled: false
      oneAgent:
        applicationMonitoring:
          namespaceSelector:
            matchLabels:
              apc.namespace.telemetry: external-dynatrace
        hostGroup: test-cluster
      skipCertCheck: false
      tokens: apc-dynatrace
      trustedCAs: apc-dynatrace-trusted-ca
  2: |
    apiVersion: external-secrets.io/v1beta1
    kind: ExternalSecret
    metadata:
      labels:
        app.kubernetes.io/instance: apc-dynatrace
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: dynatrace-instance
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: dynatrace-instance-1.0.4
      name: apc-dynatrace
      namespace: apc-dynatrace
    spec:
      data:
        - remoteRef:
            key: apc-platform/test/apc-dynatrace/token
            property: apiToken
          secretKey: apiToken
        - remoteRef:
            key: apc-platform/test/apc-dynatrace/token
            property: dataIngestToken
          secretKey: dataIngestToken
      refreshInterval: 1h
      secretStoreRef:
        kind: ClusterSecretStore
        name: vault-example
      target:
        creationPolicy: Owner
        name: apc-dynatrace
  3: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: apc-dynatrace
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: dynatrace-instance
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: dynatrace-instance-1.0.4
      name: apc-dynatrace-dynatrace-instance-activegate
      namespace: apc-dynatrace
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  apc.namespace.type: application
          ports:
            - port: http
              protocol: TCP
            - port: https
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/created-by: test-cluster
          app.kubernetes.io/managed-by: dynatrace-operator
          app.kubernetes.io/name: activegate
      policyTypes:
        - Ingress
