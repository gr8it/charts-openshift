manifests should match snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-background-controller: "true"
      name: kyverno:background-controller:opentelemetry-collector
    rules:
      - apiGroups:
          - ""
        resources:
          - serviceaccounts
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - opentelemetry.io
        resources:
          - opentelemetrycollectors
        verbs:
          - get
          - list
          - watch
          - update
          - patch
  2: |
    aggregationRule:
      clusterRoleSelectors:
        - matchLabels:
            rbac.authorization.k8s.io/apc-opentelemetry-collector-apc-observability-cluster-role: "true"
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
      name: opentelemetry-collector-tempostack-traces-write
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
        rbac.authorization.k8s.io/apc-opentelemetry-collector-apc-observability-cluster-role: "true"
      name: opentelemetry-collector-tempostack-writer-application
    rules:
      - apiGroups:
          - tempo.grafana.com
        resourceNames:
          - traces
        resources:
          - application
        verbs:
          - create
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
      name: opentelemetry-collector
    rules:
      - apiGroups:
          - ""
          - config.openshift.io
        resources:
          - pods
          - namespaces
          - infrastructures
          - infrastructures/status
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - apps
        resources:
          - replicasets
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - extensions
        resources:
          - replicasets
        verbs:
          - get
          - list
          - watch
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
