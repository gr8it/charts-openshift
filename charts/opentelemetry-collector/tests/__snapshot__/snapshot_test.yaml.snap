  8: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
      name: opentelemetry-collector-tempostack-traces-write
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: opentelemetry-collector-tempostack-traces-write
    subjects:
      - kind: ServiceAccount
        name: opentelemetry-collector-deployment
        namespace: NAMESPACE
  9: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Sync Open Telemetry tenants with namespaces
        policies.kyverno.io/title: Remove Open Telemetry tenants on namespace delete or label removal
      name: opentelemetry-collector-cleanup-tenants
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConditions:
        - expression: request.operation == 'DELETE'
          name: namespace-deleted
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - DELETE
            resources:
              - namespaces
      mutations:
        - jsonPatch:
            expression: |-
              variables.exporters.map(e, JSONPatch{op: "remove", path: "/spec/config/exporters/" + jsonpatch.escapeKey(e)}) + (('traces/' + variables.namespace) in object.spec.config.service.pipelines ? [
                JSONPatch{op: "remove", path: "/spec/config/service/pipelines/" + jsonpatch.escapeKey('traces/' + variables.namespace)}
              ] : []) + (object.spec.config.connectors.routing.table.exists(r, r.statement == variables.statement) ? [
                JSONPatch{
                  op: "replace",
                  path: "/spec/config/connectors/routing/table",
                  value: object.spec.config.connectors.routing.table.filter(r, r.statement != variables.statement)
                }
              ] : [])
          patchType: JSONPatch
      targetMatchConditions:
        - expression: variables.namespace != ''
          name: namespace-deleted
      targetMatchConstraints:
        expression: resource.Get("opentelemetry.io/v1beta1", "opentelemetrycollectors", "NAMESPACE", "opentelemetry-collector")
      variables:
        - expression: 'request.operation == ''DELETE'' ? request.oldObject.metadata.name : '''''
          name: namespace
        - expression: '''route() where resource.attributes["k8s.namespace.name"] == "'' + variables.namespace + ''"'''
          name: statement
        - expression: '[''otlp/'' + variables.namespace, ''otlp_grpc/'' + variables.namespace].filter(e, e in object.spec.config.exporters)'
          name: exporters
  10: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Sync Open Telemetry tenants with namespaces
        policies.kyverno.io/title: Sync Open Telemetry tenants on namespace create or label change
      name: opentelemetry-collector-sync-tenants
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      mutations:
        - jsonPatch:
            expression: |-
              [
                JSONPatch{
                  op: "add",
                  path: "/spec/config/exporters/" + jsonpatch.escapeKey(variables.exporter),
                  value: {
                    "endpoint": dyn("traces.svc"),
                    "auth": dyn({"authenticator": "bearertokenauth"}),
                    "headers": dyn({"X-Scope-OrgID": variables.namespace}),
                    "tls": dyn({"insecure": dyn(false), "ca_file": dyn("/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt")})
                  }
                },
                JSONPatch{
                  op: "add",
                  path: "/spec/config/service/pipelines/" + jsonpatch.escapeKey(variables.pipeline),
                  value: {"receivers": ["routing"], "exporters": [variables.exporter]}
                }
              ] + (object.spec.config.connectors.routing.table.exists(r, r.pipelines[0] == variables.pipeline) ? [] : [
                JSONPatch{
                  op: "add",
                  path: "/spec/config/connectors/routing/table/-",
                  value: {
                    "statement": dyn("route() where resource.attributes[\"k8s.namespace.name\"] == \"" + variables.namespace + "\""),
                    "pipelines": dyn([variables.pipeline])
                  }
                }
              ])
          patchType: JSONPatch
      targetMatchConstraints:
        expression: resource.Get("opentelemetry.io/v1beta1", "opentelemetrycollectors", "NAMESPACE", "opentelemetry-collector")
      variables:
        - expression: request.object.metadata.name
          name: namespace
        - expression: '''otlp_grpc/'' + variables.namespace'
          name: exporter
        - expression: '''traces/'' + variables.namespace'
          name: pipeline
  11: |
    apiVersion: opentelemetry.io/v1beta1
    kind: OpenTelemetryCollector
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
      name: opentelemetry-collector
      namespace: NAMESPACE
    spec:
      config:
        connectors:
          routing:
            default_pipelines:
              - traces/application
            table:
              - pipelines:
                  - traces/application
                statement: route() where resource.attributes["k8s.namespace.name"] == "application"
        exporters:
          otlp_grpc/application:
            auth:
              authenticator: bearertokenauth
            endpoint: traces.svc
            headers:
              X-Scope-OrgID: application
            tls:
              ca_file: /var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt
              insecure: false
          otlp_http/loki:
            auth:
              authenticator: bearertokenauth
            encoding: json
            endpoint: logs.svc
            tls:
              ca_file: /var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt
              insecure: false
          prometheus:
            endpoint: metrics.svc
            resource_to_telemetry_conversion:
              enabled: true
        extensions:
          bearertokenauth:
            filename: /var/run/secrets/kubernetes.io/serviceaccount/token
        processors:
          batch: {}
          k8s_attributes:
            extract:
              metadata:
                - k8s.namespace.name
          memory_limiter:
            check_interval: 1s
            limit_percentage: 50
            spike_limit_percentage: 30
          resourcedetection:
            detectors:
              - openshift
        receivers:
          jaeger:
            protocols:
              grpc: {}
              thrift_binary: {}
              thrift_compact: {}
              thrift_http: {}
          otlp:
            protocols:
              grpc: {}
              http: {}
          zipkin: {}
        service:
          extensions:
            - bearertokenauth
          pipelines:
            logs:
              exporters:
                - otlp_http/loki
              processors:
                - memory_limiter
                - k8s_attributes
                - resourcedetection
                - batch
              receivers:
                - otlp
            metrics:
              exporters:
                - prometheus
              processors:
                - memory_limiter
                - k8s_attributes
                - resourcedetection
                - batch
              receivers:
                - otlp
            traces:
              exporters:
                - routing
              processors:
                - memory_limiter
                - k8s_attributes
                - resourcedetection
                - batch
              receivers:
                - jaeger
                - otlp
                - zipkin
            traces/application:
              exporters:
                - otlp_grpc/application
              receivers:
                - routing
          telemetry:
            metrics:
              readers:
                - pull:
                    exporter:
                      prometheus:
                        host: 0.0.0.0
                        port: 8888
      mode: deployment
      observability:
        metrics:
          enableMetrics: true
      replicas: 2
      serviceAccount: opentelemetry-collector-deployment
  12: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: opentelemetry-collector
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: opentelemetry-collector
        app.kubernetes.io/version: v0.144.0-3
        helm.sh/chart: opentelemetry-collector-2.0.0
      name: opentelemetry-collector-deployment
      namespace: NAMESPACE
