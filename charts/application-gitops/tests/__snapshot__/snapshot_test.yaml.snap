manifests should match snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-admission-controller: "true"
      name: kyverno:admission-controller:application-gitops
    rules:
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - rolebindings
        verbs:
          - get
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.kyverno.io/aggregate-to-background-controller: "true"
      name: kyverno:background-controller:application-gitops
    rules:
      - apiGroups:
          - ""
        resources:
          - serviceaccounts
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - argoproj.io
        resources:
          - appprojects
        verbs:
          - create
          - delete
          - get
          - list
          - watch
          - update
  3: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Generate application gitops resources
        policies.kyverno.io/title: Generate ArgoCD serviceaccount
      labels:
        app.kubernetes.io/instance: application-gitops
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: application-gitops
        helm.sh/chart: application-gitops-2.0.0
      name: application-gitops-serviceaccount
    spec:
      evaluation:
        generateExisting:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: v1
              kind: ServiceAccount
              metadata:
                name: application-gitops
                namespace: (( object.metadata.namespace ))
                # not synchronized, so the ServiceAccount is not deleted with the Application by Kyverno; the ownerReference does the job
                ownerReferences:
                  - apiVersion: (( object.apiVersion ))
                    kind: (( object.kind ))
                    name: (( object.metadata.name ))
                    uid: (( object.metadata.uid ))
      matchConditions:
        - expression: object.metadata.name == object.metadata.namespace
          name: application-named-as-namespace
        - expression: dyn(resource.Get("v1", "serviceaccounts", object.metadata.namespace, "application-gitops")) == null
          name: serviceaccount-missing
      matchConstraints:
        namespaceSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - argoproj.io
            apiVersions:
              - '*'
            operations:
              - CREATE
            resources:
              - applications
  4: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Generate application gitops resources
        policies.kyverno.io/title: Generate ArgoCD appproject and rolebinding
      labels:
        app.kubernetes.io/instance: application-gitops
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: application-gitops
        helm.sh/chart: application-gitops-2.0.0
      name: application-gitops
    spec:
      evaluation:
        generateExisting:
          enabled: true
        orphanDownstreamOnPolicyDelete:
          enabled: true
        synchronize:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: argoproj.io/v1alpha1
              kind: AppProject
              metadata:
                name: (( object.metadata.namespace ))
                namespace: apc-gitops
              spec:
                description: (( object.metadata.namespace )) namespace project
                orphanedResources:
                  warn: false
                # explicitly disable cluster resource access
                clusterResourceWhitelist: []
                # allow namespaced resources only using specific service account
                destinationServiceAccounts:
                  - defaultServiceAccount: application-gitops
                    namespace: "*"
                    server: https://kubernetes.default.svc
                # allow deployment to any namespace in the cluster, using rolebinding in the destination namespace, pointing to the service account created by this policy
                # RBAC of ArgoCD is sidestepped by using "*", but Kubernetes RBAC is still in place
                destinations:
                  - namespace: "*"
                    # name: in-cluster
                    server: https://kubernetes.default.svc
                # allow applications from current namespace only
                sourceNamespaces:
                  - (( object.metadata.namespace ))
                sourceRepos:
                  - https://gitlab.example.com/**
                  - ssh://git@gitlab.example.com:**
                  - oci://gitlab.example.com/**
                  - gitlab.example.com/**
                roles:
                  - description: (( object.metadata.namespace )) project admin access
                    groups:
                      - APC-D-(( object.metadata.namespace.upperAscii() ))-PJA
                    name: admin
                    policies:
                      - p, proj:(( object.metadata.namespace )):admin, repositories, *, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):admin, applications, *, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):admin, clusters, get, https://kubernetes.default.svc, allow
                      - p, proj:(( object.metadata.namespace )):admin, exec, create, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):admin, logs, get, (( object.metadata.namespace ))/*, allow
                  - description: (( object.metadata.namespace )) project developer access
                    groups:
                      - APC-D-(( object.metadata.namespace.upperAscii() ))-DEV
                    name: developer
                    policies:
                      - p, proj:(( object.metadata.namespace )):developer, applications, get, (( object.metadata.namespace ))/*, allow
                  - description: (( object.metadata.namespace )) project operator access
                    groups:
                      - APC-D-(( object.metadata.namespace.upperAscii() ))-OPR
                    name: operator
                    policies:
                      - p, proj:(( object.metadata.namespace )):operator, repositories, *, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):operator, applications, get, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):operator, applications, sync, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):operator, clusters, get, https://kubernetes.default.svc, allow
                      - p, proj:(( object.metadata.namespace )):operator, exec, create, (( object.metadata.namespace ))/*, allow
                      - p, proj:(( object.metadata.namespace )):operator, logs, get, (( object.metadata.namespace ))/*, allow
        - template:
            interpolate: cel
            value: |
              apiVersion: rbac.authorization.k8s.io/v1
              kind: RoleBinding
              metadata:
                name: application-gitops
                namespace: (( object.metadata.namespace ))
              roleRef:
                apiGroup: rbac.authorization.k8s.io
                kind: ClusterRole
                name: apc-project-admin
              subjects:
                - kind: ServiceAccount
                  name: application-gitops
                  namespace: (( object.metadata.namespace ))
      matchConditions:
        - expression: object.metadata.name == object.metadata.namespace
          name: application-named-as-namespace
      matchConstraints:
        namespaceSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - argoproj.io
            apiVersions:
              - '*'
            operations:
              - CREATE
              - UPDATE
            resources:
              - applications
