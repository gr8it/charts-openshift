manifests should match snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
        rbac.kyverno.io/aggregate-to-admission-controller: "true"
      name: kyverno:admission-controller:openshift-distributed-tracing
    rules:
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - rolebindings
        verbs:
          - get
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
        rbac.kyverno.io/aggregate-to-background-controller: "true"
      name: kyverno:background-controller:openshift-distributed-tracing
    rules:
      - apiGroups:
          - ""
        resources:
          - serviceaccounts
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - clusterroles
        verbs:
          - create
          - delete
          - get
          - update
      - apiGroups:
          - tempo.grafana.com
        resources:
          - tempostacks
        verbs:
          - get
          - list
          - watch
          - update
          - patch
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - clusterroles
          - roles
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - bind
          - escalate
          - delete
      - apiGroups:
          - rbac.authorization.k8s.io
        resources:
          - clusterrolebindings
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - delete
      - apiGroups:
          - authentication.k8s.io
        resources:
          - tokenreviews
        verbs:
          - create
      - apiGroups:
          - authorization.k8s.io
        resources:
          - subjectaccessreviews
        verbs:
          - create
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: tempostack-traces-read
    rules:
      - apiGroups:
          - tempo.grafana.com
        resourceNames:
          - traces
          - metrics
        resources:
          - '*'
        verbs:
          - get
  4: |
    apiVersion: policies.kyverno.io/v1
    kind: GeneratingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Generate ClusterRoles for application tenants in TempoStack
        policies.kyverno.io/title: Generate ClusterRoles and RoleBindings for TempoStack tenants
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: apc-tempo-stack-generate-tenant-clusterrole
    spec:
      evaluation:
        generateExisting:
          enabled: true
        synchronize:
          enabled: true
      generate:
        - template:
            interpolate: cel
            value: |
              apiVersion: rbac.authorization.k8s.io/v1
              kind: ClusterRole
              metadata:
                name: apc-tempo-stack-writer-(( object.metadata.name ))
                labels:
                  generated-by: generate-writer-clusterrole-for-application-namespace
                  rbac.authorization.k8s.io/apc-opentelemetry-collector-apc-observability-cluster-role: "true"
              rules:
                - apiGroups:
                    - tempo.grafana.com
                  resources:
                    - (( object.metadata.name ))
                  resourceNames:
                    - traces
                  verbs:
                    - 'create'
        - template:
            interpolate: cel
            value: |
              apiVersion: rbac.authorization.k8s.io/v1
              kind: ClusterRole
              metadata:
                name: apc-tempo-stack-reader-(( object.metadata.name ))
                labels:
                  generated-by: generate-reader-clusterrole-for-application-namespace
              rules:
                - apiGroups:
                    - tempo.grafana.com
                  resources:
                    - (( object.metadata.name ))
                  resourceNames:
                    - traces
                  verbs:
                    - get
        - template:
            interpolate: cel
            value: |
              apiVersion: rbac.authorization.k8s.io/v1
              kind: ClusterRoleBinding
              metadata:
                name: apc-tempo-stack-reader-(( object.metadata.name ))
              roleRef:
                apiGroup: rbac.authorization.k8s.io
                kind: ClusterRole
                name: apc-tempo-stack-reader-(( object.metadata.name ))
              subjects:
                - kind: Group
                  name: APC-D-(( object.metadata.name.upperAscii() ))-PJA
                - kind: Group
                  name: APC-D-(( object.metadata.name.upperAscii() ))-DEV
                - kind: Group
                  name: APC-D-(( object.metadata.name.upperAscii() ))-TES
                - kind: Group
                  name: APC-D-(( object.metadata.name.upperAscii() ))-OPR
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
  5: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Cleanup TempoStack tenants
        policies.kyverno.io/title: Update TempoStack tenants on namespace delete
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: apc-tempo-stack-tempo-cleanup-tenants
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConditions:
        - expression: request.operation == 'DELETE'
          name: namespace-deleted
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - DELETE
            resources:
              - namespaces
      mutations:
        - jsonPatch:
            expression: |-
              [
                JSONPatch{
                  op: "replace",
                  path: "/spec/tenants/authentication",
                  value: object.spec.tenants.authentication.filter(t, t.tenantName != variables.namespace)
                }
              ]
          patchType: JSONPatch
      targetMatchConditions:
        - expression: variables.namespace != '' && object.spec.tenants.authentication.exists(t, t.tenantName == variables.namespace)
          name: has-tenant
      targetMatchConstraints:
        expression: resource.Get("tempo.grafana.com/v1alpha1", "tempostacks", "NAMESPACE", "apc-tempo-stack")
      variables:
        - expression: 'request.operation == ''DELETE'' ? request.oldObject.metadata.name : '''''
          name: namespace
  6: |
    apiVersion: policies.kyverno.io/v1
    kind: MutatingPolicy
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: Replace=true
        policies.kyverno.io/category: gitops
        policies.kyverno.io/minversion: 1.20.0
        policies.kyverno.io/subject: Sync TempoStack tenants with namespaces
        policies.kyverno.io/title: Update TempoStack tenants on namespace create
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: apc-tempo-stack-tempo-sync-tenants
    spec:
      evaluation:
        mutateExisting:
          enabled: true
      matchConstraints:
        objectSelector:
          matchLabels:
            apc.namespace.type: application
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - namespaces
      mutations:
        - jsonPatch:
            expression: |-
              [
                JSONPatch{
                  op: "add",
                  path: "/spec/tenants/authentication/-",
                  value: {"tenantName": variables.namespace, "tenantId": variables.namespace}
                }
              ]
          patchType: JSONPatch
      targetMatchConditions:
        - expression: '!object.spec.tenants.authentication.exists(t, t.tenantName == variables.namespace)'
          name: tenant-missing
      targetMatchConstraints:
        expression: resource.Get("tempo.grafana.com/v1alpha1", "tempostacks", "NAMESPACE", "apc-tempo-stack")
      variables:
        - expression: request.object.metadata.name
          name: namespace
  7: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: allow-from-cluster-observability-operator
      namespace: NAMESPACE
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: openshift-cluster-observability-operator
      podSelector: {}
      policyTypes:
        - Ingress
  8: |
    apiVersion: objectbucket.io/v1alpha1
    kind: ObjectBucketClaim
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: apc-tempo-stack
      namespace: NAMESPACE
    spec:
      bucketName: apc-tempo-stack
      storageClassName: ocs-storagecluster-ceph-rgw
  9: |
    apiVersion: tempo.grafana.com/v1alpha1
    kind: TempoStack
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-distributed-tracing
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-distributed-tracing
        helm.sh/chart: openshift-distributed-tracing-2.0.0
      name: apc-tempo-stack
      namespace: NAMESPACE
    spec:
      observability:
        metrics:
          createPrometheusRules: true
          createServiceMonitors: true
      retention:
        global:
          traces: 48h0m0s
      storage:
        secret:
          name: apc-tempo-stack-allinfo
          type: s3
        tls:
          caName: openshift-service-ca.crt
          enabled: true
      storageSize: 200Mi
      template:
        compactor:
          resources:
            limits:
              cpu: 500m
              memory: 1Gi
            requests:
              cpu: 100m
              memory: 150Mi
        distributor:
          component:
            resources:
              limits:
                cpu: 750m
                memory: 1Gi
              requests:
                cpu: 200m
                memory: 200Mi
        gateway:
          component:
            resources:
              limits:
                cpu: 250m
                memory: 500Mi
              requests:
                cpu: 50m
                memory: 100Mi
          enabled: true
          ingress:
            type: route
        ingester:
          resources:
            limits:
              cpu: "1"
              memory: 1536Mi
            requests:
              cpu: 250m
              memory: 400Mi
        querier:
          resources:
            limits:
              cpu: 500m
              memory: 500Mi
            requests:
              cpu: 100m
              memory: 100Mi
        queryFrontend:
          component:
            resources:
              limits:
                cpu: 250m
                memory: 500Mi
              requests:
                cpu: 50m
                memory: 100Mi
          jaegerQuery:
            enabled: true
            resources:
              limits:
                cpu: 250m
                memory: 500Mi
              requests:
                cpu: 50m
                memory: 100Mi
            tempoQuery:
              resources:
                limits:
                  cpu: 250m
                  memory: 500Mi
                requests:
                  cpu: 50m
                  memory: 100Mi
      tenants:
        authentication:
          - tenantId: application
            tenantName: application
        mode: openshift
