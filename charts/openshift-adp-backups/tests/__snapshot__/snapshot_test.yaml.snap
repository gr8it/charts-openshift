manifests should match snapshot:
  1: |
    apiVersion: kyverno.io/v1
    kind: ClusterPolicy
    metadata:
      annotations:
        policies.kyverno.io/category: Backup
        policies.kyverno.io/description: Labels ACM registration credentials so Velero skips them. They are bound to a ManagedCluster identity and must be regenerated on restore, not restored.
        policies.kyverno.io/minversion: 1.13.0
        policies.kyverno.io/subject: Secret
        policies.kyverno.io/title: Exclude ACM registration secrets from Velero backups
      labels:
        app.kubernetes.io/instance: openshift-adp-backups
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-adp-backups
        app.kubernetes.io/version: 1.1.0
        helm.sh/chart: openshift-adp-backups-1.1.0
      name: velero-exclude-acm-registration-secrets
    spec:
      background: true
      mutateExistingOnPolicyUpdate: true
      rules:
        - match:
            any:
              - resources:
                  kinds:
                    - Secret
                  selector:
                    matchExpressions:
                      - key: managedcluster-import-controller.open-cluster-management.io/import-secret
                        operator: Exists
          mutate:
            patchStrategicMerge:
              metadata:
                labels:
                  velero.io/exclude-from-backup: "true"
            targets:
              - apiVersion: v1
                kind: Secret
                name: '{{ request.object.metadata.name }}'
                namespace: '{{ request.object.metadata.namespace }}'
          name: exclude-managedcluster-import-secret
        - match:
            any:
              - resources:
                  kinds:
                    - Secret
                  names:
                    - bootstrap-hub-kubeconfig
                    - hub-kubeconfig-secret
                  namespaceSelector:
                    matchExpressions:
                      - key: createdByKlusterlet
                        operator: Exists
          mutate:
            patchStrategicMerge:
              metadata:
                labels:
                  velero.io/exclude-from-backup: "true"
            targets:
              - apiVersion: v1
                kind: Secret
                name: '{{ request.object.metadata.name }}'
                namespace: '{{ request.object.metadata.namespace }}'
          name: exclude-klusterlet-hub-kubeconfigs
  2: |
    apiVersion: velero.io/v1
    kind: Schedule
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-adp-backups
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-adp-backups
        app.kubernetes.io/version: 1.1.0
        helm.sh/chart: openshift-adp-backups-1.1.0
      name: hcp-spokea2
      namespace: openshift-adp
    spec:
      paused: false
      schedule: 0 22 * * *
      template:
        defaultVolumesToFSBackup: false
        excludedNamespaceScopedResources:
          - events
          - events.events.k8s.io
          - pods
          - replicasets.apps
        includedClusterScopedResources:
          - managedclusters.cluster.open-cluster-management.io
        includedNamespaceScopedResources:
          - '*'
        includedNamespaces:
          - spokea2
          - spokea2-spokea2
          - klusterlet-spokea2
        snapshotMoveData: false
        ttl: 336h0m0s
  3: |
    apiVersion: velero.io/v1
    kind: Schedule
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-adp-backups
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-adp-backups
        app.kubernetes.io/version: 1.1.0
        helm.sh/chart: openshift-adp-backups-1.1.0
      name: infraenv-spokea2
      namespace: openshift-adp
    spec:
      paused: false
      schedule: 15 22 * * *
      template:
        defaultVolumesToFSBackup: false
        excludedNamespaceScopedResources:
          - events
          - events.events.k8s.io
          - pods
          - replicasets.apps
        includedNamespaceScopedResources:
          - '*'
        includedNamespaces:
          - infrastructure-spokea2
        snapshotMoveData: false
        ttl: 336h0m0s
  4: |
    apiVersion: velero.io/v1
    kind: Schedule
    metadata:
      labels:
        app.kubernetes.io/instance: openshift-adp-backups
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openshift-adp-backups
        app.kubernetes.io/version: 1.1.0
        helm.sh/chart: openshift-adp-backups-1.1.0
      name: 01-test01-prometheus
      namespace: openshift-adp
    spec:
      schedule: 0 20 * * *
      template:
        includedNamespaces:
          - openshift-user-workload-monitoring
          - openshift-monitoring
        includedResources:
          - configmaps
          - persistentvolumes
          - persistentvolumeclaims
        ttl: 24h
