manifests should match snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: gatling-controller-manager-role
    rules:
      - apiGroups:
          - batch
        resources:
          - jobs
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - ""
        resources:
          - configmaps
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - ""
        resources:
          - secrets
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - authentication.k8s.io
        resources:
          - tokenreviews
        verbs:
          - create
      - apiGroups:
          - authorization.k8s.io
        resources:
          - subjectaccessreviews
        verbs:
          - create
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings/finalizers
        verbs:
          - update
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings/status
        verbs:
          - get
          - patch
          - update
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.authorization.k8s.io/aggregate-to-apc-project-admin: "true"
        rbac.authorization.k8s.io/aggregate-to-apc-project-developer: "true"
        rbac.authorization.k8s.io/aggregate-to-apc-project-operator: "true"
        rbac.authorization.k8s.io/aggregate-to-apc-project-tester: "true"
      name: gatling-controller-project-admin
    rules:
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings/finalizers
        verbs:
          - update
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings/status
        verbs:
          - get
          - patch
          - update
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        rbac.authorization.k8s.io/aggregate-to-apc-project-view: "true"
      name: gatling-controller-project-view
    rules:
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - gatling-operator.tech.zozo.com
        resources:
          - gatlings/status
        verbs:
          - get
  4: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: gatling-controller-manager-rolebinding
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: gatling-controller-manager-role
    subjects:
      - kind: ServiceAccount
        name: gatling-controller
        namespace: apc-gatling-operator
  5: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller
      namespace: apc-gatling-operator
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: apc-gatling-operator
          app.kubernetes.io/name: gatling-controller
          control-plane: controller-manager
      template:
        metadata:
          annotations:
            prometheus.io/port: "8443"
            prometheus.io/scrape: "true"
          labels:
            app.kubernetes.io/component: controller
            app.kubernetes.io/instance: apc-gatling-operator
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: gatling-controller
            app.kubernetes.io/version: 0.9.11
            control-plane: controller-manager
            helm.sh/chart: gatling-operator-1.0.0
            team: performance
        spec:
          containers:
            - args:
                - --secure-listen-address=0.0.0.0:8443
                - --upstream=http://127.0.0.1:8080/
                - --logtostderr=true
                - --v=2
                - --tls-cert-file=/etc/tls/private/tls.crt
                - --tls-private-key-file=/etc/tls/private/tls.key
              image: ghcr.io/kube-rbac-proxy/kube-rbac-proxy:v0.22.1
              livenessProbe:
                initialDelaySeconds: 15
                periodSeconds: 20
                tcpSocket:
                  port: https
              name: kube-rbac-proxy
              ports:
                - containerPort: 8443
                  name: https
              readinessProbe:
                initialDelaySeconds: 5
                periodSeconds: 10
                tcpSocket:
                  port: https
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /etc/tls/private
                  name: service-tls
                  readOnly: true
            - args:
                - --health-probe-bind-address=:8081
                - --metrics-bind-address=127.0.0.1:8080
                - --leader-elect
                - --max-concurrent-reconciles=1
              command:
                - /manager
              image: registry.example.com/platform/gatling-operator:0.9.12
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 8081
                initialDelaySeconds: 15
                periodSeconds: 20
              name: manager
              ports:
                - containerPort: 8443
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8081
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits:
                  cpu: 1
                  memory: 1Gi
                requests:
                  cpu: 250m
                  memory: 250Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: gatling-controller
          volumes:
            - name: service-tls
              secret:
                secretName: gatling-controller-tls
  6: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        cert-manager.io/cluster-issuer: example-issuer
        nginx.ingress.kubernetes.io/backend-protocol: HTTPS
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller
      namespace: apc-gatling-operator
    spec:
      ingressClassName: nginx
      rules:
        - host: gatling.example.com
          http:
            paths:
              - backend:
                  service:
                    name: gatling-controller
                    port:
                      number: 8443
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - gatling.example.com
          secretName: gatling-tls
  7: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: gatling-controller-leader-election-role
      namespace: apc-gatling-operator
    rules:
      - apiGroups:
          - ""
        resources:
          - configmaps
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - delete
      - apiGroups:
          - coordination.k8s.io
        resources:
          - leases
        verbs:
          - get
          - list
          - watch
          - create
          - update
          - patch
          - delete
      - apiGroups:
          - ""
        resources:
          - events
        verbs:
          - create
          - patch
  8: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: gatling-controller-leader-election-rolebinding
      namespace: apc-gatling-operator
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: gatling-controller-leader-election-role
    subjects:
      - kind: ServiceAccount
        name: gatling-controller
        namespace: apc-gatling-operator
  9: |
    apiVersion: v1
    kind: Service
    metadata:
      annotations:
        service.beta.openshift.io/serving-cert-secret-name: gatling-controller-tls
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller
      namespace: apc-gatling-operator
    spec:
      ports:
        - name: https
          port: 8443
          protocol: TCP
          targetPort: https
      selector:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/name: gatling-controller
        control-plane: controller-manager
      type: ClusterIP
  10: |
    apiVersion: v1
    automountServiceAccountToken: true
    kind: ServiceAccount
    metadata:
      annotations:
        example.com/owner: performance-team
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller
      namespace: apc-gatling-operator
  11: |
    apiVersion: monitoring.coreos.com/v1
    kind: ServiceMonitor
    metadata:
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller
      namespace: apc-gatling-operator
    spec:
      endpoints:
        - bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
          interval: 30s
          path: /metrics
          port: https
          scheme: https
          scrapeTimeout: 10s
          tlsConfig:
            ca:
              configMap:
                key: service-ca.crt
                name: gatling-controller-serving-certs-ca-bundle
            serverName: gatling-controller.apc-gatling-operator.svc
      selector:
        matchLabels:
          app.kubernetes.io/instance: apc-gatling-operator
          app.kubernetes.io/name: gatling-controller
          control-plane: controller-manager
  12: |
    apiVersion: v1
    data: {}
    kind: ConfigMap
    metadata:
      annotations:
        service.beta.openshift.io/inject-cabundle: "true"
      labels:
        app.kubernetes.io/instance: apc-gatling-operator
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: gatling-controller
        app.kubernetes.io/version: 0.9.11
        control-plane: controller-manager
        helm.sh/chart: gatling-operator-1.0.0
      name: gatling-controller-serving-certs-ca-bundle
      namespace: apc-gatling-operator
