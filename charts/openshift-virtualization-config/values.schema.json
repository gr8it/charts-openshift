{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hyperconverged": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveMigrationNetwork": {
          "type": "string"
        },
        "evictionStrategy": {
          "type": "string"
        },
        "vmStateStorageClass": {
          "type": "string"
        }
      },
      "required": [
        "liveMigrationNetwork",
        "evictionStrategy",
        "vmStateStorageClass"
      ]
    },
    "additionalNetworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "rawCNIConfig": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "namespace",
          "type",
          "rawCNIConfig"
        ]
      }
    },
    "global": {
      "type": "object"
    }
  },
  "required": [
    "hyperconverged",
    "additionalNetworks"
  ]
}
